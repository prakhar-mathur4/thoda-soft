{
  "name": "thoda-soft-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Thoda Soft — Shopify Online Store 2.0 theme. Tailwind is a CSS build step only; the runtime is pure Liquid + vanilla JS.",
  "scripts": {
    "build:css": "tailwindcss -i src/theme.css -o assets/theme.css --minify",
    "watch:css": "tailwindcss -i src/theme.css -o assets/theme.css --watch",
    "dev": "shopify theme dev",
    "push": "shopify theme push",
    "pull": "shopify theme pull",
    "check": "shopify theme check"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13"
  }
}
