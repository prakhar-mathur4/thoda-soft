{%- liquid
  assign fs_enabled = settings.cart_free_shipping_enabled
  assign threshold = settings.cart_free_shipping_threshold | default: 0 | times: 100
  assign subtotal = cart.items_subtotal_price
  assign remaining = threshold | minus: subtotal
  if remaining < 0
    assign remaining = 0
  endif
  assign progress = 0
  if threshold > 0
    assign progress = subtotal | times: 100.0 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  endif
-%}

{%- if cart.item_count == 0 -%}
  <div class="flex flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
    {%- render 'icon', name: 'bag', class: 'h-10 w-10 text-charcoal/30' -%}
    <p class="font-serif text-xl">Your cart is feeling soft &amp; empty</p>
    <p class="max-w-xs text-sm text-charcoal-muted">Add a piece from the debut capsule and it will appear here.</p>
    <button type="button" data-cart-close class="btn-primary mt-2">{{ 'cart.empty_cta' | t }}</button>
  </div>
{%- else -%}
  {%- if fs_enabled and threshold > 0 -%}
    <div class="border-b border-charcoal/10 px-6 py-3">
      <p class="text-xs text-charcoal-muted">
        {%- if remaining == 0 -%}
          <span class="text-sage-deep">🎉 You&apos;ve unlocked <strong>free shipping</strong>!</span>
        {%- else -%}
          You&apos;re <strong class="text-charcoal">{{ remaining | money }}</strong> away from free shipping
        {%- endif -%}
      </p>
      <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-charcoal/10">
        <div class="h-full rounded-full bg-sage-deep transition-all duration-500 ease-soft" style="width: {{ progress }}%;"></div>
      </div>
    </div>
  {%- endif -%}

  <div class="flex-1 overflow-y-auto">
    <ul class="divide-y divide-charcoal/10 px-6">
      {%- for item in cart.items -%}
        <li class="flex gap-4 py-5" data-cart-line="{{ item.key }}">
          <a href="{{ item.url }}" class="relative h-24 w-20 flex-shrink-0 overflow-hidden rounded-2xl bg-blush">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" width="80" height="96" loading="lazy" class="h-full w-full object-cover">
            {%- endif -%}
          </a>
          <div class="flex flex-1 flex-col">
            <a href="{{ item.url }}" class="font-serif text-sm transition hover:text-charcoal-muted">{{ item.product.title }}</a>
            {%- unless item.variant.title contains 'Default' -%}
              <p class="text-xs text-charcoal-muted">{{ item.variant.title }}</p>
            {%- endunless -%}

            <div class="mt-2 flex items-center gap-3">
              <div class="inline-flex items-center rounded-full border border-charcoal/20">
                <button type="button" data-qty-change data-line="{{ item.key }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity" class="px-2.5 py-1 text-base leading-none transition hover:text-charcoal-muted disabled:opacity-30"{% if item.quantity <= 1 %} disabled{% endif %}>&minus;</button>
                <span class="w-7 text-center text-sm" aria-live="polite">{{ item.quantity }}</span>
                <button type="button" data-qty-change data-line="{{ item.key }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity" class="px-2.5 py-1 text-base leading-none transition hover:text-charcoal-muted">+</button>
              </div>
            </div>

            <div class="mt-auto flex items-center justify-between pt-2">
              <span class="text-sm">{{ item.final_line_price | money }}</span>
              <button type="button" data-qty-change data-line="{{ item.key }}" data-qty="0" class="text-xs text-charcoal-muted underline-offset-2 transition hover:text-charcoal hover:underline">{{ 'cart.remove' | t }}</button>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="border-t border-charcoal/10 px-6 py-5">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="mb-4 space-y-1">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="flex items-center justify-between text-xs text-sage-deep">
            <span>&#10003; {{ discount.title }} (&minus;{{ discount.total_allocated_amount | money }})</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="mb-4 flex items-center justify-between">
      <span class="text-sm text-charcoal-muted">{{ 'cart.subtotal' | t }}</span>
      <span class="font-serif text-lg">{{ cart.items_subtotal_price | money }}</span>
    </div>

    <form action="{{ routes.cart_url }}" method="post" id="cart-drawer-form">
      <button type="submit" name="checkout" class="btn-primary w-full">{{ 'cart.checkout' | t }}</button>
    </form>
    <p class="mt-3 text-center text-xs text-charcoal-muted">{{ 'cart.shipping_note' | t }}</p>
  </div>
{%- endif -%}
