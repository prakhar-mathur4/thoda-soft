{%- comment -%}
  Renders a UI icon by name. Mirrors the original icon set 1:1.
  Usage: {% render 'icon', name: 'bag', class: 'h-5 w-5' %}
  Names: search, bag, eye, chat, whatsapp, menu, user, close, leaf,
         sparkle, pin, clock, lock, arrow-right, share, link,
         facebook, pinterest, x
{%- endcomment -%}
{%- liquid
  assign icon_class = class | default: 'h-5 w-5'
  assign stroke = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"'
-%}
{%- case name -%}
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
  {%- when 'bag' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M6 8.5h12a1 1 0 0 1 1 1.06l-.62 9a2 2 0 0 1-2 1.94H7.62a2 2 0 0 1-2-1.94l-.62-9a1 1 0 0 1 1-1.06Z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/></svg>
  {%- when 'eye' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="2.5"/></svg>
  {%- when 'chat' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M21 11.5a7.5 7.5 0 0 1-10.9 6.7L4 19.5l1.3-4.8A7.5 7.5 0 1 1 21 11.5Z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/></svg>
  {%- when 'whatsapp' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.16l-.3-.18-2.85.84.85-2.78-.2-.33A8.2 8.2 0 1 1 12 20.2Z"/><path d="M17.5 14.4c-.3-.15-1.7-.84-2-.94-.27-.1-.46-.15-.66.15-.2.3-.76.94-.93 1.13-.17.2-.34.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.66-1.6-.9-2.18-.24-.57-.48-.49-.66-.5h-.57c-.2 0-.51.07-.78.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.7-.7 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.27-.2-.56-.34Z"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  {%- when 'user' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M5 19c0-7 5-12 14-13-1 9-6 14-13 14a6 6 0 0 1-1 0Z"/><path d="M9 15c2-3 5-5 8-6"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M12 3v6m0 6v6m9-9h-6M9 12H3"/></svg>
  {%- when 'pin' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M12 21s-6-5.5-6-10a6 6 0 1 1 12 0c0 4.5-6 10-6 10Z"/><circle cx="12" cy="11" r="2"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
  {%- when 'arrow-right' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'share' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M12 15V4"/><path d="m8 8 4-4 4 4"/><path d="M6 12v6a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-6"/></svg>
  {%- when 'link' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><path d="M10 13.5a3.5 3.5 0 0 0 5 0l2.5-2.5a3.5 3.5 0 0 0-5-5L11 7.5"/><path d="M14 10.5a3.5 3.5 0 0 0-5 0L6.5 13a3.5 3.5 0 0 0 5 5L13 16.5"/></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z"/></svg>
  {%- when 'pinterest' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.64 19.32c-.02-.78-.04-1.97.16-2.82.18-.78 1.17-4.98 1.17-4.98s-.3-.6-.3-1.48c0-1.39.8-2.42 1.8-2.42.85 0 1.26.64 1.26 1.4 0 .85-.54 2.13-.82 3.31-.24.99.5 1.8 1.47 1.8 1.76 0 3.12-1.86 3.12-4.55 0-2.38-1.71-4.04-4.15-4.04-2.83 0-4.5 2.12-4.5 4.32 0 .85.33 1.77.74 2.27.08.1.09.19.07.29-.08.31-.25 1-.28 1.13-.04.18-.15.22-.34.13-1.25-.58-2.04-2.42-2.04-3.9 0-3.17 2.3-6.09 6.65-6.09 3.49 0 6.2 2.49 6.2 5.81 0 3.47-2.18 6.26-5.22 6.26-1.02 0-1.98-.53-2.3-1.16l-.63 2.4c-.23.87-.85 1.97-1.26 2.64A10 10 0 1 0 12 2Z"/></svg>
  {%- when 'x' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" fill="currentColor" aria-hidden="true"><path d="M17.53 3h3.13l-6.84 7.82L22 21h-6.3l-4.93-6.44L5.13 21H2l7.32-8.36L2 3h6.46l4.46 5.9L17.53 3Zm-1.1 16.13h1.73L7.65 4.78H5.8l10.63 14.35Z"/></svg>
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" class="{{ icon_class }}" {{ stroke }} aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.8"/><path d="M17.4 6.6h.01"/></svg>
{%- endcase -%}
