{%- liquid
  assign wa = settings.whatsapp_number
-%}
<div data-chat-widget data-whatsapp="{{ wa }}">
  <button
    type="button"
    data-chat-toggle
    aria-label="Open help chat"
    aria-expanded="false"
    class="fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-charcoal text-cream shadow-lg transition hover:scale-105 active:scale-100"
  >
    <span data-chat-icon-open>{%- render 'icon', name: 'chat', class: 'h-6 w-6' -%}</span>
    <span data-chat-icon-close class="hidden">{%- render 'icon', name: 'close', class: 'h-6 w-6' -%}</span>
  </button>

  <div
    data-chat-panel
    role="dialog"
    aria-label="Help chat"
    aria-hidden="true"
    class="pointer-events-none fixed bottom-24 right-5 z-50 flex max-h-[70vh] w-[min(360px,calc(100vw-2.5rem))] translate-y-3 flex-col overflow-hidden rounded-3xl bg-cream opacity-0 shadow-[0_16px_50px_rgba(46,43,41,0.22)] transition-all duration-300 ease-soft"
  >
    <div class="flex items-center justify-between bg-charcoal px-5 py-4 text-cream">
      <div>
        <p class="font-serif text-base">Thoda Soft Help</p>
        <p class="text-[11px] text-cream/70">Typically replies in minutes</p>
      </div>
      <button type="button" data-chat-close aria-label="{{ 'general.accessibility.close' | t }}" class="rounded-full p-1.5 transition hover:bg-cream/10">
        {%- render 'icon', name: 'close' -%}
      </button>
    </div>

    <div data-chat-messages class="flex-1 space-y-3 overflow-y-auto px-4 py-4">
      <div class="max-w-[85%]">
        <div class="rounded-2xl rounded-tl-sm bg-blush/60 px-3.5 py-2.5 text-sm text-charcoal">Hi! 👋 How can we help? Pick a topic below, or chat with us on WhatsApp.</div>
      </div>
    </div>

    <div class="border-t border-charcoal/10 px-4 py-3">
      <div class="mb-3 flex flex-wrap gap-2">
        {%- assign topics = 'Sizing &amp; fit|We offer inclusive sizing from XS to XXL — true to size with a relaxed, feminine drape. Between sizes? Size down for a closer fit.;Shipping|Free shipping across India. Orders are dispatched in 1–2 business days, with delivery in about 4–7 days.;Returns &amp; exchanges|We offer easy 7-day size exchanges from delivery — items unworn, unwashed, tags intact.;COD &amp; payments|We accept UPI, cards, and wallets, plus Cash on Delivery — all via secure checkout.;Track my order|You will get a tracking link by SMS and email once your order ships. For a specific order, chat with us on WhatsApp.' | split: ';' -%}
        {%- for topic in topics -%}
          {%- assign parts = topic | split: '|' -%}
          <button type="button" data-chat-topic data-answer="{{ parts[1] | escape }}" class="rounded-full border border-charcoal/20 px-3 py-1.5 text-xs text-charcoal transition hover:border-charcoal hover:bg-charcoal hover:text-cream">{{ parts[0] }}</button>
        {%- endfor -%}
      </div>
      <button type="button" data-chat-whatsapp class="flex w-full items-center justify-center gap-2 rounded-full bg-[#25D366] py-3 text-sm font-medium text-white transition hover:opacity-90">
        {%- render 'icon', name: 'whatsapp', class: 'h-5 w-5' -%} Chat with us on WhatsApp
      </button>
    </div>
  </div>
</div>
