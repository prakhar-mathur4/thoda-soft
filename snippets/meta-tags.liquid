{%- comment -%}
  Open Graph + Twitter Card tags — rich link previews when a page or product is
  shared (WhatsApp, Facebook, Instagram, X, Pinterest, iMessage, etc.).
{%- endcomment -%}
{%- liquid
  # Title
  assign og_title = page_title | default: shop.name

  # Description (page → product → shop → name)
  if page_description != blank
    assign og_description = page_description
  elsif template.name == 'product' and product.description != blank
    assign og_description = product.description | strip_html | truncate: 200
  elsif shop.description != blank
    assign og_description = shop.description
  else
    assign og_description = shop.name
  endif

  # Type
  assign og_type = 'website'
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  endif

  # Image (product/article/collection specific → default share image → logo)
  assign og_image = ''
  if template.name == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200
  elsif template.name == 'article' and article.image
    assign og_image = article.image | image_url: width: 1200
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image | image_url: width: 1200
  elsif settings.share_image != blank
    assign og_image = settings.share_image | image_url: width: 1200
  elsif settings.logo != blank
    assign og_image = settings.logo | image_url: width: 1200
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- if og_image != blank -%}
  {%- assign og_image_url = og_image | prepend: 'https:' -%}
  <meta property="og:image" content="{{ og_image_url }}">
  <meta property="og:image:secure_url" content="{{ og_image_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}
{%- if og_type == 'product' -%}
  {%- assign og_variant = product.selected_or_first_available_variant -%}
  <meta property="product:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if og_variant.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
  <meta name="twitter:image" content="{{ og_image | prepend: 'https:' }}">
{%- endif -%}
