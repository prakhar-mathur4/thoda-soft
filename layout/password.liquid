<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_cream }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }} &ndash; {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Playwrite+NZ:wght@100..400&display=swap"
      rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="bg-cream text-charcoal font-sans antialiased">
    <main class="container-editorial flex min-h-screen flex-col items-center justify-center py-16 text-center">
      {%- if settings.logo -%}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          class="mx-auto mb-8 h-14 w-auto object-contain"
          width="200"
          height="53">
      {%- else -%}
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name | escape }}"
          class="mx-auto mb-8 h-14 w-auto object-contain"
          width="200"
          height="53">
      {%- endif -%}

      <h2 class="font-serif text-2xl">{{ 'general.password_page.login_form_heading' | t | default: 'Opening soon' }}</h2>

      {%- form 'storefront_password', class: 'mt-6 flex w-full max-w-sm items-center gap-2' -%}
        <input
          type="password"
          name="password"
          class="flex-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm text-charcoal outline-none placeholder:text-charcoal-muted"
          placeholder="{{ 'general.password_page.password_placeholder' | t | default: 'Enter password' }}"
          aria-label="Password">
        <button type="submit" class="btn-primary">{{ 'general.password_page.login_form_submit' | t | default: 'Enter' }}</button>
        {%- if form.errors -%}
          <p class="mt-3 w-full text-sm text-charcoal">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="mt-10 text-xs uppercase tracking-[0.2em] text-charcoal-muted">{{ powered_by_link }}</p>
    </main>
    {%- comment -%} Required by Shopify; our branded form above is the visible one {%- endcomment -%}
    <div hidden>{{ content_for_layout }}</div>
  </body>
</html>
