{%- comment -%}
  Uses Shopify's native Product Recommendations. Loaded lazily by global.js via
  ?section_id=product-recommendations so it renders after the recommendations
  API resolves.
{%- endcomment -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <section class="bg-cream" data-product-recommendations>
    <div class="container-editorial py-16 sm:py-20">
      <div class="mx-auto mb-12 max-w-xl text-center" data-reveal>
        <h2 class="font-serif text-3xl sm:text-4xl">{{ section.settings.heading | default: 'You may also like' }}</h2>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-4" data-reveal data-reveal-stagger>
        {%- for product in recommendations.products limit: section.settings.products_count -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- else -%}
  <div data-product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id=product-recommendations&product_id={{ product.id }}&limit={{ section.settings.products_count }}"></div>
{%- endif -%}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_count", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
