{%- liquid
  assign email = section.settings.email | default: shop.email
  assign wa = section.settings.whatsapp_number | default: settings.whatsapp_number
  assign wa_text = section.settings.whatsapp_text | default: 'Hi Thoda Soft! I have a question.'
-%}
<div class="container-editorial py-14 sm:py-20">
  <div class="mx-auto max-w-2xl">
    <header class="mb-8" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="font-serif text-4xl sm:text-5xl">{{ section.settings.heading | default: page.title | default: 'Contact Us' }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="mt-4 text-pretty text-sm leading-relaxed text-charcoal/75 sm:text-base">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    <div class="space-y-4 text-sm leading-relaxed text-charcoal/80 [&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-charcoal [&_strong]:text-charcoal [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5" data-reveal>
      <h2>{{ section.settings.reach_title | default: 'Reach us' }}</h2>
      <ul>
        <li><strong>Email:</strong> <a href="mailto:{{ email }}">{{ email }}</a></li>
        {%- if wa != blank -%}
          <li><strong>WhatsApp:</strong> <a href="https://wa.me/{{ wa }}?text={{ wa_text | url_encode }}" target="_blank" rel="noopener noreferrer">Chat with us</a></li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li><strong>Support hours:</strong> {{ section.settings.hours }}</li>
        {%- endif -%}
        {%- if section.settings.address != blank -%}
          <li><strong>Address:</strong> {{ section.settings.address }}</li>
        {%- endif -%}
      </ul>

      {%- if section.settings.show_quick_links -%}
        <h2>{{ section.settings.quick_title | default: 'Quick links' }}</h2>
        <ul>
          {%- for block in section.blocks -%}
            {%- if block.type == 'quick_link' -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>{% if block.settings.note != blank %} — {{ block.settings.note }}{% endif %}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.business_details != blank -%}
        <h2>{{ section.settings.business_title | default: 'Business details' }}</h2>
        <p class="text-charcoal-muted">{{ section.settings.business_details }}</p>
      {%- endif -%}

      {%- if page.content != blank -%}
        {{ page.content }}
      {%- endif -%}
    </div>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact {{ shop.name }}",
  "url": {{ shop.url | append: page.url | json }},
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "email": {{ email | json }}
    {%- if section.settings.address != blank -%},
    "address": { "@type": "PostalAddress", "streetAddress": {{ section.settings.address | json }} }
    {%- endif -%}
  }
}
</script>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Thoda Soft" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "We'd love to help — with sizing, orders, exchanges, or anything else." },
    { "type": "header", "content": "Reach us" },
    { "type": "text", "id": "reach_title", "label": "Section title", "default": "Reach us" },
    { "type": "text", "id": "email", "label": "Email", "default": "thodasoft@gmail.com" },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "info": "Country code + number, no + or spaces. Leave empty to hide. Falls back to Theme settings." },
    { "type": "text", "id": "whatsapp_text", "label": "WhatsApp prefilled text", "default": "Hi Thoda Soft! I have a question." },
    { "type": "text", "id": "hours", "label": "Support hours", "default": "Mon–Sat, 10am–7pm IST. We typically reply within one business day." },
    { "type": "text", "id": "address", "label": "Address", "default": "76/22, Shipra Path, Mansarovar, Jaipur (Raj.) — 302020" },
    { "type": "header", "content": "Quick links" },
    { "type": "checkbox", "id": "show_quick_links", "label": "Show Quick links", "default": true },
    { "type": "text", "id": "quick_title", "label": "Section title", "default": "Quick links" },
    { "type": "header", "content": "Business details" },
    { "type": "text", "id": "business_title", "label": "Section title", "default": "Business details" },
    { "type": "textarea", "id": "business_details", "label": "Business details", "default": "Thoda Soft, 76/22, Shipra Path, Mansarovar, Jaipur (Raj.) — 302020." }
  ],
  "blocks": [
    {
      "type": "quick_link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "FAQ" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "text", "id": "note", "label": "Note (after —)" }
      ]
    }
  ]
}
{% endschema %}
