{%- comment -%}
  Editorial gallery — asymmetrical grid of "look" blocks. Each look: image,
  optional title, styling note, linked products (Shop the Look), and a
  collection link. Fully managed in the Theme Editor / Shopify Admin.
{%- endcomment -%}
<section class="bg-cream">
  <div class="container-editorial py-8 sm:py-12">
    {%- if section.settings.heading != blank -%}
      <div class="mx-auto mb-12 max-w-xl text-center" data-reveal>
        <h2 class="font-serif text-3xl sm:text-4xl">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="grid grid-cols-1 gap-5 sm:gap-6 md:grid-cols-6">
      {%- for block in section.blocks -%}
        {%- liquid
          case block.settings.layout
            when 'full'
              assign col = 'md:col-span-6'
              assign ratio = 'aspect-[16/10]'
            when 'landscape'
              assign col = 'md:col-span-4'
              assign ratio = 'aspect-[3/2]'
            when 'portrait'
              assign col = 'md:col-span-2'
              assign ratio = 'aspect-[3/4]'
            when 'third'
              assign col = 'md:col-span-2'
              assign ratio = 'aspect-[4/5]'
            else
              assign col = 'md:col-span-3'
              assign ratio = 'aspect-[4/5]'
          endcase
          assign img = block.settings.image
          assign has_products = false
          if block.settings.products != blank and block.settings.products.size > 0
            assign has_products = true
          endif
          assign look_url = ''
          if block.settings.collection != blank
            assign look_url = block.settings.collection.url
          endif
        -%}
        <article class="group {{ col }}" {{ block.shopify_attributes }} data-look>
          <div class="relative {{ ratio }} w-full overflow-hidden rounded-3xl bg-blush">
            {%- if img -%}
              <img
                src="{{ img | image_url: width: 1400 }}"
                srcset="{{ img | image_url: width: 700 }} 700w, {{ img | image_url: width: 1100 }} 1100w, {{ img | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 768px) 60vw, 100vw"
                alt="{{ img.alt | escape | default: block.settings.title | default: 'Thoda Soft look' }}"
                width="1400" height="1750" loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1100ms] ease-soft group-hover:scale-[1.04]">
            {%- endif -%}

            {%- comment -%} Hover overlay {%- endcomment -%}
            <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-charcoal/45 via-charcoal/5 to-transparent p-6 opacity-0 transition-opacity duration-500 ease-soft group-hover:opacity-100 sm:p-7">
              {%- if block.settings.title != blank -%}
                <h3 class="translate-y-3 font-serif text-xl text-cream transition-transform duration-500 ease-soft group-hover:translate-y-0 sm:text-2xl">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="mt-1 translate-y-3 text-sm text-cream/85 transition-transform delay-75 duration-500 ease-soft group-hover:translate-y-0">{{ block.settings.note }}</p>
              {%- endif -%}
              {%- if has_products or look_url != blank -%}
                <div class="mt-4 translate-y-3 transition-transform delay-100 duration-500 ease-soft group-hover:translate-y-0">
                  {%- if has_products -%}
                    <button type="button" data-shop-look class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-cream/95 px-5 py-2.5 text-[11px] uppercase tracking-[0.14em] text-charcoal shadow-sm backdrop-blur transition hover:bg-white">Shop this Look</button>
                  {%- elsif look_url != blank -%}
                    <a href="{{ look_url }}" class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-cream/95 px-5 py-2.5 text-[11px] uppercase tracking-[0.14em] text-charcoal shadow-sm backdrop-blur transition hover:bg-white">Shop this Look</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Static caption below (always readable / accessible) {%- endcomment -%}
          {%- if block.settings.title != blank or block.settings.note != blank -%}
            <div class="mt-4 px-1">
              {%- if block.settings.title != blank -%}<h3 class="font-serif text-lg text-charcoal">{{ block.settings.title }}</h3>{%- endif -%}
              {%- if block.settings.note != blank -%}<p class="mt-0.5 text-sm text-charcoal-muted">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} Shop the Look — floating product cards, toggled open {%- endcomment -%}
          {%- if has_products -%}
            <div data-look-products class="hidden">
              <div class="mt-4 grid grid-cols-2 gap-4 rounded-3xl bg-blush/40 p-4 sm:grid-cols-3">
                {%- for product in block.settings.products -%}
                  {%- render 'lookbook-product', product: product -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- for i in (1..3) -%}
          <div class="aspect-[4/5] rounded-3xl bg-blush md:col-span-2"></div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook gallery",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "full", "label": "Full width" },
            { "value": "landscape", "label": "Landscape (wide)" },
            { "value": "half", "label": "Half" },
            { "value": "portrait", "label": "Portrait (tall)" },
            { "value": "third", "label": "Third (small)" }
          ],
          "default": "half"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "note", "label": "Styling note" },
        { "type": "product_list", "id": "products", "label": "Featured products", "limit": 6 },
        { "type": "collection", "id": "collection", "label": "Collection link", "info": "Used for 'Shop this Look' when no products are set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook gallery",
      "blocks": [
        { "type": "look", "settings": { "layout": "half", "title": "Morning Ease", "note": "Soft layers for slower mornings." } },
        { "type": "look", "settings": { "layout": "half", "title": "Golden Hour", "note": "Made for golden hour walks." } },
        { "type": "look", "settings": { "layout": "full", "title": "The Everyday Edit", "note": "Wear comfort beautifully." } },
        { "type": "look", "settings": { "layout": "third", "title": "Coffee Run" } },
        { "type": "look", "settings": { "layout": "third", "title": "Bookstore Afternoons" } },
        { "type": "look", "settings": { "layout": "third", "title": "Quiet Confidence" } }
      ]
    }
  ]
}
{% endschema %}
