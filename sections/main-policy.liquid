<div class="container-editorial py-14 sm:py-20">
  <div class="mx-auto max-w-2xl">
    <header class="mb-8" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="font-serif text-4xl sm:text-5xl">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.intro != blank -%}
        <p class="mt-4 text-pretty text-sm leading-relaxed text-charcoal/75 sm:text-base">{{ section.settings.intro }}</p>
      {%- endif -%}
      {%- if section.settings.updated != blank -%}
        <p class="mt-3 text-xs text-charcoal-muted">Last updated: {{ section.settings.updated }}</p>
      {%- endif -%}
    </header>

    <div class="space-y-4 text-sm leading-relaxed text-charcoal/80 [&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-xl [&_h2]:text-charcoal [&_strong]:text-charcoal [&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_p]:mb-0" data-reveal>
      {%- for block in section.blocks -%}
        {%- if block.type == 'section' -%}
          {%- if block.settings.heading != blank -%}<h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>{%- endif -%}
          {{ block.settings.body }}
        {%- endif -%}
      {%- endfor -%}

      {%- if page.content != blank -%}
        {{ page.content }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Thoda Soft" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "updated", "label": "Last updated", "info": "e.g. June 2026. Leave empty to hide." }
  ],
  "blocks": [
    {
      "type": "section",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "body", "label": "Body" }
      ]
    }
  ]
}
{% endschema %}
