<div class="container-editorial py-12 sm:py-16">
  <div class="mx-auto mb-8 max-w-xl text-center" data-reveal>
    <h1 class="font-serif text-3xl sm:text-4xl">Collections</h1>
  </div>

  {%- if collections.size > 0 -%}
    <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-3" data-reveal data-reveal-stagger>
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="group block">
          <div class="overflow-hidden rounded-3xl bg-blush">
            {%- if collection.featured_image -%}
              <img
                src="{{ collection.featured_image | image_url: width: 700 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
                width="700"
                height="875"
                class="aspect-[4/5] w-full object-cover transition duration-500 group-hover:scale-[1.03]">
            {%- else -%}
              <div class="aspect-[4/5] w-full"></div>
            {%- endif -%}
          </div>
          <h2 class="mt-3 font-serif text-lg text-charcoal sm:text-xl">{{ collection.title }}</h2>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "List collections"
}
{% endschema %}
