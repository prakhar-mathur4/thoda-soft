{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile
  assign show_caption = section.settings.show_caption
  assign banner_link = blank
  if show_caption == false and section.settings.cta_link != blank
    assign banner_link = section.settings.cta_link
  endif
  assign text_light = true
  if section.settings.text_color == 'dark'
    assign text_light = false
  endif
-%}
<section data-hero class="relative w-full overflow-hidden bg-blush">
  <div class="relative min-h-[86vh] w-full">
    {%- comment -%} Full-bleed image; optional separate portrait image below md {%- endcomment -%}
    {%- if img != blank -%}
      <picture>
        {%- if img_mobile != blank -%}
          <source
            media="(max-width: 767px)"
            srcset="{{ img_mobile | image_url: width: 600 }} 600w, {{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1200 }} 1200w"
            sizes="100vw">
        {%- endif -%}
        <img
          src="{{ img | image_url: width: 2000 }}"
          srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w, {{ img | image_url: width: 2800 }} 2800w"
          sizes="100vw"
          alt="{{ img.alt | escape | default: section.settings.title | default: shop.name }}"
          width="2000" height="1333" fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover">
      </picture>
    {%- else -%}
      <img
        src="{{ 'hero-home.jpg' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="2000" height="1333" fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover">
    {%- endif -%}

    {%- if show_caption -%}
    {%- comment -%} Soft bottom gradient for caption legibility {%- endcomment -%}
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent"></div>

    {%- comment -%} Centered caption {%- endcomment -%}
    <div class="absolute inset-x-0 bottom-0 flex flex-col items-center px-6 pb-12 text-center {% if text_light %}text-cream{% else %}text-charcoal{% endif %} sm:pb-16">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-4 text-[0.7rem] uppercase tracking-[0.3em] opacity-90">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h1 class="font-serif text-xl uppercase leading-tight tracking-[0.3em] sm:text-3xl"><span class="block pl-[0.3em]">{{ section.settings.title }}</span></h1>
      {%- endif -%}
      {%- if section.settings.show_divider -%}
        <div class="mt-5 flex items-center justify-center gap-4">
          <span class="h-px w-12 {% if text_light %}bg-cream/60{% else %}bg-charcoal/50{% endif %} sm:w-16"></span>
          {%- render 'icon', name: 'sparkle', class: 'h-3.5 w-3.5 opacity-90' -%}
          <span class="h-px w-12 {% if text_light %}bg-cream/60{% else %}bg-charcoal/50{% endif %} sm:w-16"></span>
        </div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="mt-7 inline-block border-b border-current pb-1 text-xs uppercase tracking-[0.2em] transition-opacity hover:opacity-70">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    {%- else -%}
      {%- comment -%} Artwork carries its own text: keep the heading for SEO / screen readers only {%- endcomment -%}
      {%- if section.settings.title != blank -%}<h1 class="sr-only">{{ section.settings.title }}</h1>{%- endif -%}
      {%- if banner_link != blank -%}
        <a href="{{ banner_link }}" class="absolute inset-0" aria-label="{{ section.settings.cta_label | default: section.settings.title | default: shop.name | escape }}"></a>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image", "info": "Upload a wide landscape image. If empty, the bundled default image is used." },
    { "type": "image_picker", "id": "image_mobile", "label": "Hero image (mobile)", "info": "Optional tall portrait image shown on phones. If empty, the main image is used." },
    { "type": "checkbox", "id": "show_caption", "label": "Show text over the image", "info": "Turn off when the image already has its text designed in. The title stays as a hidden heading, and the button link makes the whole banner clickable.", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small line above title)" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Debut Capsule" },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider ornament", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "select", "id": "text_color", "label": "Text colour",
      "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ],
      "default": "light"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
