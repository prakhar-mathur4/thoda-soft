{%- liquid
  assign primary = section.settings.primary_image
  assign secondary = section.settings.secondary_image
-%}
<section
  data-hero
  id="top"
  aria-label="{{ section.settings.aria_label | default: shop.name }}"
  class="relative w-full overflow-hidden bg-gradient-to-br from-cream via-blush/40 to-lavender/30 pb-14 pt-5 md:pb-0 md:pt-5"
>
  {%- comment -%} Ambient colour light {%- endcomment -%}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div data-glow class="absolute -left-24 top-10 h-72 w-72 rounded-full bg-lavender/50 blur-3xl"></div>
    <div data-glow class="absolute right-0 top-1/3 h-80 w-80 rounded-full bg-blush/60 blur-3xl"></div>
    <div data-glow class="absolute -bottom-24 left-1/3 h-72 w-72 rounded-full bg-sage/40 blur-3xl"></div>
  </div>

  <span data-anim="spine" aria-hidden="true" class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rotate-90 text-[0.65rem] uppercase tracking-[0.5em] text-charcoal/60 lg:block">{{ section.settings.spine_label | default: 'Dressed in ease' }}</span>

  <div class="container-editorial grid grid-cols-1 items-center gap-y-10 md:grid-cols-12 md:gap-x-8">
    {%- comment -%} Editorial copy {%- endcomment -%}
    <div data-scroll-text class="order-2 md:order-none md:col-span-5 md:row-start-1 md:self-center">
      <div data-anim="eyebrow" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.7rem] uppercase tracking-[0.32em] text-charcoal">
        <span class="font-medium">{{ section.settings.eyebrow_1 | default: 'Issue Nº 01' }}</span>
        <span aria-hidden="true" class="h-1 w-1 rounded-full bg-charcoal/40"></span>
        <span>{{ section.settings.eyebrow_2 | default: 'The Debut Capsule' }}</span>
        <span aria-hidden="true" class="h-1 w-1 rounded-full bg-charcoal/40"></span>
        <span>{{ section.settings.eyebrow_3 | default: "SS'26" }}</span>
      </div>
      <div data-anim="rule" aria-hidden="true" class="mt-4 h-px w-full max-w-sm bg-charcoal/25"></div>

      <h1 class="mt-7 font-serif text-[clamp(2.4rem,5.4vw,4.5rem)] font-medium leading-[0.98] tracking-[-0.02em] text-charcoal">
        <span class="block overflow-hidden pb-[0.16em] -mb-[0.16em]"><span data-anim="line" class="block">{{ section.settings.headline_1 | default: 'Wear your' }}</span></span>
        <span class="block overflow-hidden pb-[0.16em] -mb-[0.16em]"><span data-anim="line" class="block font-light italic">{{ section.settings.headline_2 | default: 'softness' }}</span></span>
        <span class="block overflow-hidden pb-[0.16em] -mb-[0.16em]"><span data-anim="line" class="block">{{ section.settings.headline_3 | default: 'like confidence.' }}</span></span>
      </h1>

      <p data-anim="standfirst" class="mt-7 max-w-md text-pretty text-base leading-relaxed text-charcoal sm:text-lg">{{ section.settings.standfirst | default: "Premium, breathable cotton cut for slow mornings and restless nights. Designed in India for women who'd rather feel like themselves than like everyone else." }}</p>

      <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
        <a data-anim="cta" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="group inline-flex items-center gap-3 rounded-full bg-charcoal px-8 py-3.5 text-sm tracking-wide text-cream transition duration-300 ease-soft hover:bg-charcoal/90 hover:scale-[1.02] focus-visible:scale-[1.02]">
          {{ section.settings.cta1_label | default: 'Explore the Shop' }}
          <span aria-hidden="true" class="transition-transform duration-300 ease-soft group-hover:translate-x-1">&rarr;</span>
        </a>
        {%- if section.settings.cta2_label != blank -%}
          <a data-anim="cta" href="{{ section.settings.cta2_link | default: '/' }}" class="bg-gradient-to-r from-charcoal to-charcoal bg-[length:0%_1px] bg-left-bottom bg-no-repeat pb-1 text-sm tracking-wide text-charcoal transition-[background-size] duration-300 ease-soft hover:bg-[length:100%_1px]">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Layered photo collage {%- endcomment -%}
    <div data-scroll-photo class="relative order-1 mx-auto h-[48svh] min-h-[330px] w-full max-w-[400px] md:order-none md:col-start-7 md:col-span-6 md:row-start-1 md:mx-0 md:h-[80vh] md:max-w-none">
      <div class="absolute right-0 top-0 h-[82%] w-[74%] md:h-[88%] md:w-[68%]">
        <div data-anim="frame-primary" class="relative h-full w-full overflow-hidden rounded-[1.75rem] shadow-[0_30px_60px_-30px_rgba(137,91,58,0.45)] ring-1 ring-white/40">
          <div class="absolute inset-0 scale-105">
            {%- if primary -%}
              <img src="{{ primary | image_url: width: 900 }}" alt="{{ primary.alt | escape }}" width="900" height="1200" fetchpriority="high" class="h-full w-full object-cover">
            {%- else -%}
              <div class="h-full w-full bg-blush-deep"></div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="absolute bottom-0 left-0 h-[52%] w-[50%] md:h-[50%] md:w-[44%]">
        <div data-anim="frame-secondary" class="relative h-full w-full overflow-hidden rounded-[1.5rem] border-[5px] border-cream shadow-[0_24px_50px_-24px_rgba(137,91,58,0.5)]">
          <div class="absolute inset-0 scale-105">
            {%- if secondary -%}
              <img src="{{ secondary | image_url: width: 600 }}" alt="{{ secondary.alt | escape }}" width="600" height="750" loading="lazy" class="h-full w-full object-cover">
            {%- else -%}
              <div class="h-full w-full bg-lavender"></div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "primary_image", "label": "Primary (portrait)" },
    { "type": "image_picker", "id": "secondary_image", "label": "Secondary (overlay)" },
    { "type": "header", "content": "Eyebrow" },
    { "type": "text", "id": "eyebrow_1", "label": "Part 1", "default": "Issue Nº 01" },
    { "type": "text", "id": "eyebrow_2", "label": "Part 2", "default": "The Debut Capsule" },
    { "type": "text", "id": "eyebrow_3", "label": "Part 3", "default": "SS'26" },
    { "type": "header", "content": "Headline" },
    { "type": "text", "id": "headline_1", "label": "Line 1", "default": "Wear your" },
    { "type": "text", "id": "headline_2", "label": "Line 2 (italic)", "default": "softness" },
    { "type": "text", "id": "headline_3", "label": "Line 3", "default": "like confidence." },
    { "type": "textarea", "id": "standfirst", "label": "Standfirst", "default": "Premium, breathable cotton cut for slow mornings and restless nights. Designed in India for women who'd rather feel like themselves than like everyone else." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta1_label", "label": "Primary label", "default": "Explore the Shop" },
    { "type": "url", "id": "cta1_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary label", "default": "Read our story" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "header", "content": "Misc" },
    { "type": "text", "id": "spine_label", "label": "Spine label", "default": "Dressed in ease" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
