{%- liquid
  # Image source: the uploaded image, else the first product of the hero
  # collection (picked here, or the automated collection with handle `hero`).
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile
  assign hero_col = section.settings.hero_collection
  if hero_col == blank
    assign hero_col = collections['hero']
  endif
  if img == blank and hero_col != blank and hero_col.products.size > 0
    assign img = hero_col.products.first.featured_image
  endif
  assign alt = img.alt | default: section.settings.title | default: shop.name

  assign text_light = true
  if section.settings.text_color == 'dark'
    assign text_light = false
  endif
  assign text_cls = 'text-cream'
  assign line_cls = 'bg-cream/60'
  if text_light == false
    assign text_cls = 'text-charcoal'
    assign line_cls = 'bg-charcoal/50'
  endif

  assign min_h = 'min-h-[calc(100svh-3.5rem)] sm:min-h-[calc(100svh-4rem)]'
  if section.settings.height == 'tall'
    assign min_h = 'min-h-[70svh]'
  endif
-%}
<section data-hero class="relative w-full overflow-hidden bg-blush">
  <div class="relative w-full {{ min_h }}">
    {%- comment -%} Full-bleed image {%- endcomment -%}
    {%- if img != blank -%}
      <img
        src="{{ img | image_url: width: 2000 }}"
        srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2000 }} 2000w, {{ img | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ alt | escape }}"
        width="2400" height="1500"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover {% if img_mobile != blank %}hidden sm:block{% endif %}">
      {%- if img_mobile != blank -%}
        <img
          src="{{ img_mobile | image_url: width: 1000 }}"
          srcset="{{ img_mobile | image_url: width: 600 }} 600w, {{ img_mobile | image_url: width: 1000 }} 1000w, {{ img_mobile | image_url: width: 1400 }} 1400w"
          sizes="100vw"
          alt="{{ alt | escape }}"
          width="1000" height="1400"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover sm:hidden">
      {%- endif -%}
    {%- else -%}
      <div class="absolute inset-0 bg-gradient-to-br from-blush via-blush-deep to-lavender/40"></div>
    {%- endif -%}

    {%- comment -%} Legibility overlays: soft bottom gradient + optional tint {%- endcomment -%}
    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-t from-black/30 via-black/5 to-transparent"></div>
    {%- if section.settings.overlay > 0 -%}
      <div aria-hidden="true" class="absolute inset-0" style="background-color: rgba(0,0,0,{{ section.settings.overlay | divided_by: 100.0 }});"></div>
    {%- endif -%}

    {%- comment -%} Centered caption at the lower third {%- endcomment -%}
    <div class="absolute inset-x-0 bottom-0 flex flex-col items-center px-6 pb-10 text-center {{ text_cls }} sm:pb-14">
      {%- if section.settings.eyebrow != blank -%}
        <div data-anim="eyebrow" class="mb-4"><span class="block text-[0.7rem] uppercase tracking-[0.3em] opacity-90">{{ section.settings.eyebrow }}</span></div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="overflow-hidden font-serif text-xl uppercase leading-tight tracking-[0.3em] sm:text-3xl" data-line-mask>
          <span data-anim="line" class="block pl-[0.3em]">{{ section.settings.title }}</span>
        </h1>
      {%- endif -%}

      {%- if section.settings.show_divider -%}
        <div data-anim="cta" class="mt-5 flex items-center justify-center gap-4">
          <span class="h-px w-12 {{ line_cls }} sm:w-16"></span>
          {%- render 'icon', name: 'sparkle', class: 'h-3.5 w-3.5 opacity-90' -%}
          <span class="h-px w-12 {{ line_cls }} sm:w-16"></span>
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a data-anim="cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="mt-7 inline-block border-b border-current pb-1 text-xs uppercase tracking-[0.2em] transition-opacity hover:opacity-70">{{ section.settings.cta_label }}</a>
      {%- endif -%}

      {%- comment -%} Scroll cue {%- endcomment -%}
      <div data-anim="scroll" class="mt-8 h-10 w-px overflow-hidden {{ line_cls }} motion-reduce:hidden" aria-hidden="true">
        <span class="block h-4 w-px animate-scrollcue {% if text_light %}bg-cream{% else %}bg-charcoal{% endif %}"></span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (mobile — optional portrait)" },
    { "type": "collection", "id": "hero_collection", "label": "Hero products collection", "info": "If no image is set, uses the first product's featured image from this collection (or the collection named 'hero')." },
    { "type": "header", "content": "Caption" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (small line above)", "default": "" },
    { "type": "text", "id": "title", "label": "Title", "default": "The Debut Capsule" },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider ornament", "default": true },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    {
      "type": "select", "id": "text_color", "label": "Text colour",
      "options": [ { "value": "light", "label": "Light (on dark image)" }, { "value": "dark", "label": "Dark (on light image)" } ],
      "default": "light"
    },
    { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 15 },
    {
      "type": "select", "id": "height", "label": "Height",
      "options": [ { "value": "full", "label": "Full screen" }, { "value": "tall", "label": "Tall (70%)" } ],
      "default": "full"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
