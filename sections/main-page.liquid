{%- liquid
  assign narrow = section.settings.narrow
-%}
<div class="container-editorial py-14 sm:py-20">
  <div class="mx-auto {% if narrow %}max-w-2xl{% else %}max-w-4xl{% endif %}">
    <header class="mb-8 {% if section.settings.center %}text-center{% endif %}" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="font-serif text-3xl sm:text-4xl">{{ page.title }}</h1>
    </header>
    <div class="prose-editorial max-w-none text-charcoal/80 leading-relaxed [&_h2]:mt-8 [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:text-charcoal [&_h3]:mt-6 [&_h3]:font-serif [&_h3]:text-xl [&_p]:mb-4 [&_ul]:my-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1.5 [&_a]:text-charcoal [&_a]:underline [&_a]:underline-offset-2" data-reveal>
      {{ page.content }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "checkbox", "id": "center", "label": "Center heading", "default": false },
    { "type": "checkbox", "id": "narrow", "label": "Narrow width", "default": true }
  ]
}
{% endschema %}
