{%- liquid
  # Each column uses its linked Shopify menu when set; otherwise it falls back to
  # the default links below (as "Label|url;Label|url") so the footer matches the
  # design out of the box without depending on the store's menus.
  assign explore_fallback = 'Shop|/collections/all;Lookbook|/pages/lookbook;Our Story|/pages/our-story'
  assign help_fallback = 'FAQ|/pages/faq;Size Guide|/pages/size-guide;Shipping Policy|/pages/shipping;Returns & Exchanges|/pages/returns;Contact|/pages/contact'
  assign legal_fallback = 'Contact|/pages/contact;Privacy Policy|/policies/privacy-policy;Terms|/policies/terms-of-service'
-%}
<footer class="bg-cream">
  <div class="container-editorial border-t border-charcoal/10 py-14 sm:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-8">
      {%- comment -%} Brand + newsletter {%- endcomment -%}
      <div class="md:col-span-5">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 440 }}" alt="{{ shop.name | escape }}" width="220" height="53" class="h-12 w-auto object-contain">
        {%- else -%}
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="220" height="53" class="h-12 w-auto object-contain">
        {%- endif -%}
        <p class="mt-4 max-w-sm text-pretty text-sm text-charcoal-muted">
          {{ section.settings.newsletter_text | default: 'Join the mood board. Get 10% off your first capsule piece.' }}
        </p>
        <div class="mt-5 max-w-md">
          {%- form 'customer', class: 'newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="hidden" name="contact[accepts_marketing]" value="true">
            {%- if form.posted_successfully? -%}
              <p class="rounded-full bg-sage/40 px-5 py-3 text-sm text-charcoal">{{ 'general.newsletter.success' | t }}</p>
            {%- else -%}
              <div class="flex items-center gap-2">
                <input
                  type="email"
                  name="contact[email]"
                  required
                  autocomplete="email"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'your@email.com' }}"
                  aria-label="{{ section.settings.newsletter_placeholder | default: 'your@email.com' }}"
                  class="min-w-0 flex-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm text-charcoal outline-none transition placeholder:text-charcoal-muted focus:border-charcoal/40">
                <button type="submit" class="btn-primary shrink-0 whitespace-nowrap">{{ section.settings.newsletter_button | default: 'Get 10% Off' }}</button>
              </div>
              {%- if form.errors -%}
                <p class="mt-2 text-xs text-charcoal">{{ form.errors | default_errors }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

      {%- comment -%} Link columns {%- endcomment -%}
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 md:col-span-7">
        <nav aria-label="{{ section.settings.menu_1_title | default: 'Explore' }}">
          <h2 class="mb-4 text-xs uppercase tracking-[0.2em] text-charcoal-muted">{{ section.settings.menu_1_title | default: 'Explore' }}</h2>
          <ul class="space-y-2.5 text-sm">
            {%- if section.settings.menu_1 != blank and linklists[section.settings.menu_1].links.size > 0 -%}
              {%- for link in linklists[section.settings.menu_1].links -%}
                <li><a href="{{ link.url }}" class="text-charcoal/80 transition-colors hover:text-charcoal">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign items = explore_fallback | split: ';' -%}
              {%- for item in items -%}{%- assign parts = item | split: '|' -%}
                <li><a href="{{ parts[1] }}" class="text-charcoal/80 transition-colors hover:text-charcoal">{{ parts[0] }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>

        <nav aria-label="{{ section.settings.menu_2_title | default: 'Help' }}">
          <h2 class="mb-4 text-xs uppercase tracking-[0.2em] text-charcoal-muted">{{ section.settings.menu_2_title | default: 'Help' }}</h2>
          <ul class="space-y-2.5 text-sm">
            {%- if section.settings.menu_2 != blank and linklists[section.settings.menu_2].links.size > 0 -%}
              {%- for link in linklists[section.settings.menu_2].links -%}
                <li><a href="{{ link.url }}" class="text-charcoal/80 transition-colors hover:text-charcoal">{{ link.title }}</a></li>
              {%- endfor -%}
            {%- else -%}
              {%- assign items = help_fallback | split: ';' -%}
              {%- for item in items -%}{%- assign parts = item | split: '|' -%}
                <li><a href="{{ parts[1] }}" class="text-charcoal/80 transition-colors hover:text-charcoal">{{ parts[0] }}</a></li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </nav>

        <div class="col-span-2 sm:col-span-1">
          <h2 class="mb-4 text-xs uppercase tracking-[0.2em] text-charcoal-muted">{{ section.settings.promise_title | default: 'Promise' }}</h2>
          <ul class="space-y-3 text-sm">
            {%- for block in section.blocks -%}
              {%- if block.type == 'promise' -%}
                <li class="flex items-center gap-2.5" {{ block.shopify_attributes }}>
                  {%- render 'icon', name: block.settings.icon, class: 'h-4 w-4 text-charcoal' -%}
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center gap-4 border-t border-charcoal/10 pt-6 text-xs text-charcoal-muted sm:flex-row sm:justify-between">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright_suffix | default: 'Designed in India.' }}</p>
      <nav aria-label="Legal" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        {%- if section.settings.menu_legal != blank and linklists[section.settings.menu_legal].links.size > 0 -%}
          {%- for link in linklists[section.settings.menu_legal].links -%}
            <a href="{{ link.url }}" class="transition-colors hover:text-charcoal">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- assign items = legal_fallback | split: ';' -%}
          {%- for item in items -%}{%- assign parts = item | split: '|' -%}
            <a href="{{ parts[1] }}" class="transition-colors hover:text-charcoal">{{ parts[0] }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Join the mood board. Get 10% off your first capsule piece." },
    { "type": "text", "id": "newsletter_placeholder", "label": "Email placeholder", "default": "your@email.com" },
    { "type": "text", "id": "newsletter_button", "label": "Newsletter button", "default": "Get 10% Off" },
    { "type": "header", "content": "Column 1 — Explore" },
    { "type": "text", "id": "menu_1_title", "label": "Title", "default": "Explore" },
    { "type": "link_list", "id": "menu_1", "label": "Menu (optional)", "info": "Leave empty to use the default links: Shop, Lookbook, Our Story." },
    { "type": "header", "content": "Column 2 — Help" },
    { "type": "text", "id": "menu_2_title", "label": "Title", "default": "Help" },
    { "type": "link_list", "id": "menu_2", "label": "Menu (optional)", "info": "Leave empty to use the default links: FAQ, Size Guide, Shipping Policy, Returns & Exchanges, Contact." },
    { "type": "header", "content": "Column 3 — Promise" },
    { "type": "text", "id": "promise_title", "label": "Title", "default": "Promise" },
    { "type": "header", "content": "Legal bar" },
    { "type": "text", "id": "copyright_suffix", "label": "Copyright suffix", "default": "Designed in India." },
    { "type": "link_list", "id": "menu_legal", "label": "Legal menu (optional)", "info": "Leave empty to use the default links: Contact, Privacy Policy, Terms." }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "lock", "label": "Lock" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "pin", "label": "Pin" }
          ],
          "default": "clock"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "7-Day Size Exchanges" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "promise", "settings": { "icon": "clock", "text": "7-Day Size Exchanges" } },
        { "type": "promise", "settings": { "icon": "lock", "text": "Secure Checkout" } }
      ]
    }
  ]
}
{% endschema %}
