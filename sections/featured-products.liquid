{%- liquid
  assign collection = collections[section.settings.collection]
  assign limit = section.settings.products_count | default: 4
-%}
<section id="{{ section.settings.anchor | default: 'capsule' }}" class="scroll-mt-24 bg-cream">
  <div class="container-editorial py-16 sm:py-24">
    <div class="mx-auto mb-12 max-w-xl text-center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="font-serif text-3xl sm:text-4xl">{{ section.settings.heading | default: 'The Debut Capsule' }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="mt-3 text-pretty text-sm text-charcoal-muted sm:text-base">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div data-reveal>
      <div data-carousel>
        <div
          data-carousel-track
          class="-mr-5 flex snap-x snap-mandatory gap-4 overflow-x-auto pr-5 pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mr-0 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:overflow-visible sm:pr-0 sm:pb-0"
        >
          {%- if collection != blank and collection.products.size > 0 -%}
            {%- for product in collection.products limit: limit -%}
              <div class="w-[80%] shrink-0 snap-start sm:w-full">
                {%- render 'product-card', product: product -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..limit) -%}
              <div class="w-[80%] shrink-0 snap-start sm:w-full">
                <div class="aspect-[4/5] w-full rounded-4xl bg-blush"></div>
                <div class="mt-4 h-4 w-2/3 rounded bg-blush"></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if collection.products.size > 1 -%}
          <div data-carousel-dots class="mt-6 flex justify-center gap-2 sm:hidden"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Debut Capsule" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Four pieces. Endlessly wearable. Made to be lived in." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "capsule" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
