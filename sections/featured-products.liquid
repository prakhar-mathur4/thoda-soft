{%- liquid
  assign tag = section.settings.tag | default: 'featured'
  assign limit = section.settings.products_count | default: 4

  # Source to scan: an explicit collection if chosen, else the whole catalogue.
  assign source = collections[section.settings.collection]
  if source == blank
    assign source = collections.all
  endif

  # Match the tag case-insensitively, up to the limit.
  assign lower_tag = tag | downcase

  # Desktop: 2-column grid (default) or the same swipeable row as mobile.
  assign desktop_carousel = false
  if section.settings.desktop_layout == 'carousel'
    assign desktop_carousel = true
  endif
  if desktop_carousel
    assign track_desktop = 'sm:mr-0 sm:gap-6 sm:pr-0'
    assign slide_desktop = 'sm:w-[44%] lg:w-[38%]'
  else
    assign track_desktop = 'sm:mr-0 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:gap-y-12 sm:overflow-visible sm:pr-0 sm:pb-0'
    assign slide_desktop = 'sm:w-full'
  endif
-%}
<section id="{{ section.settings.anchor | default: 'capsule' }}" class="scroll-mt-24 bg-cream">
  <div class="container-editorial py-16 sm:py-24">
    <div class="mx-auto mb-12 max-w-xl text-center" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="font-serif text-3xl sm:text-4xl">{{ section.settings.heading | default: 'The Debut Capsule' }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="mt-3 text-pretty text-sm text-charcoal-muted sm:text-base">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div data-reveal>
      <div data-carousel>
        <div
          data-carousel-track
          class="-mr-5 flex snap-x snap-mandatory gap-4 overflow-x-auto pr-5 pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden {{ track_desktop }}"
        >
          {%- assign shown = 0 -%}
          {%- for product in source.products -%}
            {%- assign product_tags_lower = product.tags | join: ',' | downcase | split: ',' -%}
            {%- if product_tags_lower contains lower_tag -%}
              <div class="w-[80%] shrink-0 snap-start {{ slide_desktop }}">
                {%- render 'product-card', product: product -%}
              </div>
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown >= limit -%}{%- break -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if shown == 0 -%}
            {%- comment -%} Editor / empty fallback: keep the layout legible {%- endcomment -%}
            {%- for i in (1..limit) -%}
              <div class="w-[80%] shrink-0 snap-start {{ slide_desktop }}">
                <div class="aspect-[4/5] w-full rounded-4xl bg-blush"></div>
                <div class="mt-4 h-4 w-2/3 rounded bg-blush"></div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        {%- if desktop_carousel -%}
          <div class="mt-6 flex items-center justify-center gap-5">
            <button type="button" data-carousel-prev aria-label="Previous products" class="hidden h-10 w-10 items-center justify-center rounded-full border border-charcoal/20 text-charcoal transition hover:border-charcoal sm:inline-flex">
              {%- render 'icon', name: 'arrow-right', class: 'h-4 w-4 rotate-180' -%}
            </button>
            <div data-carousel-dots class="flex justify-center gap-2"></div>
            <button type="button" data-carousel-next aria-label="Next products" class="hidden h-10 w-10 items-center justify-center rounded-full border border-charcoal/20 text-charcoal transition hover:border-charcoal sm:inline-flex">
              {%- render 'icon', name: 'arrow-right', class: 'h-4 w-4' -%}
            </button>
          </div>
        {%- else -%}
          <div data-carousel-dots class="mt-6 flex justify-center gap-2 sm:hidden"></div>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank and shown > 0 -%}
        <div class="mt-10 text-center sm:mt-14">
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn-primary">{{ section.settings.button_label }}</a>
        </div>
      {%- endif -%}

      {%- if shown == 0 and request.design_mode -%}
        <p class="mt-6 text-center text-xs text-charcoal-muted">No products found with the tag &ldquo;{{ tag }}&rdquo;. Tag products with <strong>{{ tag }}</strong> in Shopify admin to feature them here.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "paragraph", "content": "Shows products carrying the tag below. Tag products with it in Shopify admin (Products → tags) to feature them here." },
    { "type": "text", "id": "tag", "label": "Product tag", "default": "featured" },
    { "type": "range", "id": "products_count", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    { "type": "collection", "id": "collection", "label": "Limit to collection (optional)", "info": "Leave empty to scan all products." },
    {
      "type": "select", "id": "desktop_layout", "label": "Desktop layout",
      "options": [ { "value": "grid", "label": "Grid (2 columns)" }, { "value": "carousel", "label": "Carousel (swipe / arrows)" } ],
      "default": "grid", "info": "Phones always use the swipeable carousel."
    },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Limited Drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Debut Capsule" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Six pieces. Endlessly wearable. Made to be lived in." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all pieces", "info": "Leave empty to hide the button." },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to all products." },
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "capsule" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
