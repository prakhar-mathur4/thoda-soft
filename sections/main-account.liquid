{%- comment -%}
  Custom branded account page for a theme PAGE (/pages/account). Works with
  Shopify "new customer accounts": reads the `customer` object when logged in
  and degrades gracefully — whatever data is available renders; order history
  links out to the hosted account when not directly accessible.
{%- endcomment -%}
<div class="container-editorial max-w-4xl py-16 sm:py-20">
  {%- if customer -%}
    {%- comment -%} Header {%- endcomment -%}
    <div class="flex flex-wrap items-start justify-between gap-4" data-reveal>
      <div>
        <p class="mb-2 text-xs uppercase tracking-[0.25em] text-charcoal-muted">Your account</p>
        <h1 class="font-serif text-3xl sm:text-4xl">Hi, {{ customer.first_name | default: customer.name | default: 'there' }}</h1>
        <p class="mt-2 text-sm text-charcoal-muted">{{ section.settings.welcome | default: "Welcome back to Thoda Soft — here's everything in one soft place." }}</p>
      </div>
      <a href="{{ routes.account_logout_url }}" class="shrink-0 rounded-full border border-charcoal/20 px-5 py-2 text-xs uppercase tracking-[0.12em] text-charcoal transition hover:border-charcoal">{{ 'customer.log_out' | t | default: 'Log out' }}</a>
    </div>

    {%- comment -%} Quick links {%- endcomment -%}
    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3" data-reveal data-reveal-stagger>
      <a href="{{ routes.account_url }}" class="group flex items-center gap-4 rounded-3xl bg-blush/40 p-5 transition hover:bg-blush/60">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-charcoal">{%- render 'icon', name: 'bag', class: 'h-5 w-5' -%}</span>
        <span><span class="block font-serif text-lg text-charcoal">Orders</span><span class="block text-xs text-charcoal-muted">View your orders</span></span>
      </a>
      <a href="{{ routes.account_addresses_url | default: routes.account_url }}" class="group flex items-center gap-4 rounded-3xl bg-blush/40 p-5 transition hover:bg-blush/60">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-charcoal">{%- render 'icon', name: 'pin', class: 'h-5 w-5' -%}</span>
        <span><span class="block font-serif text-lg text-charcoal">Addresses</span><span class="block text-xs text-charcoal-muted">Delivery details</span></span>
      </a>
      <a href="{{ routes.all_products_collection_url }}" class="group flex items-center gap-4 rounded-3xl bg-blush/40 p-5 transition hover:bg-blush/60">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cream text-charcoal">{%- render 'icon', name: 'sparkle', class: 'h-5 w-5' -%}</span>
        <span><span class="block font-serif text-lg text-charcoal">Keep shopping</span><span class="block text-xs text-charcoal-muted">Explore the capsule</span></span>
      </a>
    </div>

    {%- comment -%} Default address (if available) {%- endcomment -%}
    {%- if customer.default_address -%}
      <div class="mt-6 rounded-3xl border border-charcoal/10 p-6" data-reveal>
        <div class="flex items-center justify-between">
          <h2 class="text-xs uppercase tracking-[0.14em] text-charcoal-muted">Default address</h2>
          <a href="{{ routes.account_addresses_url | default: routes.account_url }}" class="text-xs uppercase tracking-[0.12em] text-charcoal underline underline-offset-2 hover:text-charcoal-muted">Edit</a>
        </div>
        <address class="mt-3 text-sm not-italic leading-relaxed text-charcoal/80">{{ customer.default_address.name }}<br>{{ customer.default_address | format_address }}</address>
      </div>
    {%- endif -%}

    {%- comment -%} Order history — shows if the customer object exposes orders,
        otherwise links to the hosted account. {%- endcomment -%}
    <h2 class="mt-14 font-serif text-2xl">{{ 'customer.order_history' | t | default: 'Order history' }}</h2>
    {%- if customer.orders and customer.orders.size > 0 -%}
      <div class="mt-6 overflow-x-auto rounded-3xl border border-charcoal/10" data-reveal>
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead>
            <tr class="border-b border-charcoal/10 text-xs uppercase tracking-[0.12em] text-charcoal-muted">
              <th class="px-5 py-4 font-normal">Order</th>
              <th class="px-5 py-4 font-normal">Date</th>
              <th class="px-5 py-4 font-normal">Payment</th>
              <th class="px-5 py-4 font-normal">Fulfillment</th>
              <th class="px-5 py-4 text-right font-normal">Total</th>
            </tr>
          </thead>
          <tbody>
            {%- for order in customer.orders -%}
              <tr class="border-b border-charcoal/5 transition hover:bg-blush/20">
                <td class="px-5 py-4"><a href="{{ order.customer_url }}" class="font-medium text-charcoal underline-offset-2 hover:underline">{{ order.name }}</a></td>
                <td class="px-5 py-4 text-charcoal-muted">{{ order.created_at | date: '%b %d, %Y' }}</td>
                <td class="px-5 py-4"><span class="inline-flex rounded-full bg-charcoal/5 px-2.5 py-1 text-xs text-charcoal">{{ order.financial_status_label }}</span></td>
                <td class="px-5 py-4"><span class="inline-flex rounded-full bg-charcoal/5 px-2.5 py-1 text-xs text-charcoal">{{ order.fulfillment_status_label }}</span></td>
                <td class="px-5 py-4 text-right font-medium text-charcoal">{{ order.total_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- else -%}
      <div class="mt-6 rounded-3xl bg-blush/40 p-8 text-center" data-reveal>
        <p class="text-sm text-charcoal-muted">View and track all your orders in your Thoda Soft account.</p>
        <a href="{{ routes.account_url }}" class="btn-primary mt-5">View my orders</a>
      </div>
    {%- endif -%}

  {%- else -%}
    {%- comment -%} Logged-out state {%- endcomment -%}
    <div class="mx-auto max-w-md py-10 text-center" data-reveal>
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">Your account</p>
      <h1 class="font-serif text-3xl sm:text-4xl">{{ section.settings.login_heading | default: 'Sign in to Thoda Soft' }}</h1>
      <p class="mx-auto mt-4 max-w-sm text-sm text-charcoal-muted">{{ section.settings.login_text | default: 'Sign in to view your orders, track deliveries, and manage your addresses.' }}</p>
      <a href="{{ routes.account_login_url }}" class="btn-primary mt-7">Sign in</a>
      <p class="mt-4 text-sm text-charcoal-muted">New here? <a href="{{ routes.account_register_url | default: routes.account_login_url }}" class="text-charcoal underline underline-offset-2 hover:text-charcoal-muted">Create an account</a></p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Account",
  "settings": [
    { "type": "text", "id": "welcome", "label": "Welcome line", "default": "Welcome back to Thoda Soft — here's everything in one soft place." },
    { "type": "text", "id": "login_heading", "label": "Logged-out heading", "default": "Sign in to Thoda Soft" },
    { "type": "textarea", "id": "login_text", "label": "Logged-out text", "default": "Sign in to view your orders, track deliveries, and manage your addresses." }
  ]
}
{% endschema %}
