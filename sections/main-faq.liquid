{%- # theme-check-disable UnclosedHTMLElement -%}
{%- comment -%}
  Categories and questions are flat blocks rendered sequentially: a `category`
  block opens a <section>, following `qa` blocks fill it, the next category (or
  end) closes it. The HTML is balanced at render time; theme-check's static
  parser can't follow the cross-iteration open/close, so that check is disabled.
{%- endcomment -%}
{%- liquid
  assign cta_email = section.settings.cta_email | default: shop.email
-%}
<div class="container-editorial py-14 sm:py-20">
  <header class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="font-serif text-4xl sm:text-5xl">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="mx-auto mt-4 max-w-xl text-pretty text-sm leading-relaxed text-charcoal/75 sm:text-base">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  <div class="mx-auto max-w-3xl space-y-12">
    {%- assign open_group = false -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'category' -%}
          {%- if open_group -%}</div></section>{%- endif -%}
          <section {{ block.shopify_attributes }}>
            <h2 class="mb-2 font-serif text-2xl text-charcoal">{{ block.settings.title }}</h2>
            <div>
          {%- assign open_group = true -%}
        {%- when 'qa' -%}
          {%- unless open_group -%}<section><div>{%- assign open_group = true -%}{%- endunless -%}
          <details class="group border-b border-charcoal/15 py-4" {{ block.shopify_attributes }}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base text-charcoal marker:hidden">
              {{ block.settings.question }}
              <span class="shrink-0 text-xl leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span>
            </summary>
            <div class="mt-3 max-w-2xl text-sm leading-relaxed text-charcoal/75 [&_a]:underline [&_a]:underline-offset-2 [&_p]:mb-2">{{ block.settings.answer }}</div>
          </details>
      {%- endcase -%}
    {%- endfor -%}
    {%- if open_group -%}</div></section>{%- endif -%}
  </div>

  {%- if section.settings.show_cta -%}
    <div class="mx-auto mt-16 max-w-3xl border-t border-charcoal/10 pt-10 text-center" data-reveal>
      <h2 class="font-serif text-2xl">{{ section.settings.cta_heading | default: 'Still have a question?' }}</h2>
      {%- if section.settings.cta_body != blank -%}
        <p class="mx-auto mt-3 max-w-md text-sm text-charcoal-muted">{{ section.settings.cta_body }}</p>
      {%- endif -%}
      <a href="mailto:{{ cta_email }}" class="btn-primary mt-6">{{ section.settings.cta_label | default: 'Email Us' }}</a>
      {%- if section.settings.cta_note != blank -%}
        <p class="mt-6 text-sm text-charcoal-muted">{{ section.settings.cta_note }} <a href="{{ section.settings.cta_note_link | default: '/collections/all' }}" class="underline underline-offset-2 hover:text-charcoal">{{ section.settings.cta_note_link_label | default: 'capsule' }}</a>.</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{%- comment -%} FAQPage structured data built from the Q&A blocks {%- endcomment -%}
{%- assign qas = section.blocks | where: 'type', 'qa' -%}
{%- if qas.size > 0 -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[
{%- for b in qas -%}
{"@type":"Question","name":{{ b.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.answer | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help Centre" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Everything you need to know about shipping, exchanges, sizing, and caring for your Thoda Soft pieces." },
    { "type": "header", "content": "Contact call to action" },
    { "type": "checkbox", "id": "show_cta", "label": "Show contact CTA", "default": true },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Still have a question?" },
    { "type": "textarea", "id": "cta_body", "label": "Body", "default": "We’re happy to help. Reach out and our team will get back to you within one business day." },
    { "type": "text", "id": "cta_email", "label": "Email", "default": "thodasoft@gmail.com" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Email Us" },
    { "type": "text", "id": "cta_note", "label": "Note before link", "default": "Or keep browsing the" },
    { "type": "text", "id": "cta_note_link_label", "label": "Link label", "default": "capsule" },
    { "type": "url", "id": "cta_note_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        { "type": "text", "id": "title", "label": "Category title", "default": "Orders & Shipping" }
      ]
    },
    {
      "type": "qa",
      "name": "Question & answer",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Orders are dispatched within 1–2 business days.</p>" }
      ]
    }
  ]
}
{% endschema %}
