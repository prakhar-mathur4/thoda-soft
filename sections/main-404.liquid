<div class="container-editorial flex min-h-[60vh] flex-col items-center justify-center py-20 text-center sm:py-28">
  <h1 class="font-serif text-3xl sm:text-4xl">{{ 'general.404.title' | t | default: 'Page not found' }}</h1>
  <p class="mt-4 max-w-md text-pretty text-sm text-charcoal-muted sm:text-base">
    {{ 'general.404.subtext' | t | default: "The page you were looking for drifted off. Let's get you back to the good stuff." }}
  </p>
  <a href="{{ routes.root_url }}" class="btn-primary mt-8">{{ 'general.404.link' | t | default: 'Back to home' }}</a>
</div>

{% schema %}
{
  "name": "404"
}
{% endschema %}
