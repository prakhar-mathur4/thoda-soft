{%- comment -%}
  Pinterest-style masonry via CSS columns — varying heights, generous spacing,
  lazy-loaded. Images added as blocks in the Theme Editor.
{%- endcomment -%}
<section class="bg-cream">
  <div class="container-editorial py-16 sm:py-24">
    {%- if section.settings.heading != blank -%}
      <div class="mx-auto mb-12 max-w-xl text-center" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<p class="mb-3 text-xs uppercase tracking-[0.3em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="font-serif text-3xl sm:text-4xl">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="columns-2 gap-4 sm:gap-6 md:columns-3 lg:columns-4 [&>*]:mb-4 sm:[&>*]:mb-6">
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image -%}
        <div class="break-inside-avoid" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="block overflow-hidden rounded-3xl bg-blush">{%- else -%}<div class="overflow-hidden rounded-3xl bg-blush">{%- endif -%}
            {%- if img -%}
              <img
                src="{{ img | image_url: width: 700 }}"
                srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 700 }} 700w"
                sizes="(min-width: 1024px) 22vw, (min-width: 768px) 30vw, 45vw"
                alt="{{ img.alt | escape | default: 'Thoda Soft moment' }}"
                width="{{ img.width }}" height="{{ img.height }}" loading="lazy"
                class="w-full transition-transform duration-700 ease-soft hover:scale-[1.03]">
            {%- else -%}
              <div class="aspect-[3/4] w-full"></div>
            {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </div>
      {%- endfor -%}

      {%- if section.blocks.size == 0 -%}
        {%- assign ph = '3/4,4/5,3/5,4/5,3/4,1/1,4/5,3/4' | split: ',' -%}
        {%- for r in ph -%}<div class="break-inside-avoid"><div class="aspect-[{{ r }}] w-full rounded-3xl bg-blush"></div></div>{%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lookbook masonry",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "More moments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A softer way of dressing" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook masonry",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" },
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
