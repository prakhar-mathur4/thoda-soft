<div class="container-editorial py-14 sm:py-20">
  <header class="mx-auto mb-12 max-w-2xl text-center" data-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="font-serif text-4xl sm:text-5xl">{{ section.settings.heading | default: 'Size Guide' }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="mx-auto mt-4 max-w-xl text-pretty text-sm leading-relaxed text-charcoal/75 sm:text-base">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  <div class="mx-auto max-w-3xl space-y-14">
    {%- comment -%} Size chart with unit toggle {%- endcomment -%}
    <section data-size-chart>
      <h2 class="mb-4 font-serif text-2xl">Size Chart</h2>
      <div class="mb-4 inline-flex rounded-full border border-charcoal/20 p-1">
        <button type="button" data-size-unit="in" aria-pressed="true" class="rounded-full px-5 py-1.5 text-xs uppercase tracking-[0.12em] transition aria-pressed:bg-charcoal aria-pressed:text-cream text-charcoal hover:opacity-70">Inches</button>
        <button type="button" data-size-unit="cm" aria-pressed="false" class="rounded-full px-5 py-1.5 text-xs uppercase tracking-[0.12em] transition aria-pressed:bg-charcoal aria-pressed:text-cream text-charcoal hover:opacity-70">Centimetres</button>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[420px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-charcoal/20">
              <th scope="col" class="py-3 pr-4 font-serif text-base font-normal">Size</th>
              <th scope="col" class="py-3 pr-4 font-serif text-base font-normal">Bust</th>
              <th scope="col" class="py-3 pr-4 font-serif text-base font-normal">Waist</th>
              <th scope="col" class="py-3 font-serif text-base font-normal">Hip</th>
            </tr>
          </thead>
          <tbody data-unit="in">
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">S</th><td class="py-3 pr-4 text-charcoal/80">33–34</td><td class="py-3 pr-4 text-charcoal/80">26–27</td><td class="py-3 text-charcoal/80">36–37</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">M</th><td class="py-3 pr-4 text-charcoal/80">35–36</td><td class="py-3 pr-4 text-charcoal/80">28–29</td><td class="py-3 text-charcoal/80">38–39</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">L</th><td class="py-3 pr-4 text-charcoal/80">37–39</td><td class="py-3 pr-4 text-charcoal/80">30–32</td><td class="py-3 text-charcoal/80">40–42</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">XL</th><td class="py-3 pr-4 text-charcoal/80">40–42</td><td class="py-3 pr-4 text-charcoal/80">33–35</td><td class="py-3 text-charcoal/80">43–45</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">XXL</th><td class="py-3 pr-4 text-charcoal/80">43–45</td><td class="py-3 pr-4 text-charcoal/80">36–38</td><td class="py-3 text-charcoal/80">46–48</td></tr>
          </tbody>
          <tbody data-unit="cm" hidden>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">S</th><td class="py-3 pr-4 text-charcoal/80">84–86</td><td class="py-3 pr-4 text-charcoal/80">66–69</td><td class="py-3 text-charcoal/80">91–94</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">M</th><td class="py-3 pr-4 text-charcoal/80">89–91</td><td class="py-3 pr-4 text-charcoal/80">71–74</td><td class="py-3 text-charcoal/80">96–99</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">L</th><td class="py-3 pr-4 text-charcoal/80">94–99</td><td class="py-3 pr-4 text-charcoal/80">76–81</td><td class="py-3 text-charcoal/80">102–107</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">XL</th><td class="py-3 pr-4 text-charcoal/80">102–107</td><td class="py-3 pr-4 text-charcoal/80">84–89</td><td class="py-3 text-charcoal/80">109–114</td></tr>
            <tr class="border-b border-charcoal/10"><th scope="row" class="py-3 pr-4 font-medium uppercase text-charcoal">XXL</th><td class="py-3 pr-4 text-charcoal/80">109–114</td><td class="py-3 pr-4 text-charcoal/80">91–96</td><td class="py-3 text-charcoal/80">117–122</td></tr>
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-xs text-charcoal-muted">Measurements are body measurements, not garment measurements. Each piece is then cut with a relaxed, feminine drape.</p>
    </section>

    {%- comment -%} How to measure {%- endcomment -%}
    <section>
      <h2 class="mb-5 font-serif text-2xl">How to Measure</h2>
      <dl class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        <div class="rounded-2xl bg-[#f7dfdf]/50 p-5"><dt class="font-serif text-lg text-charcoal">Bust</dt><dd class="mt-2 text-sm leading-relaxed text-charcoal/75">Measure around the fullest part of your bust, keeping the tape level and parallel to the floor.</dd></div>
        <div class="rounded-2xl bg-[#f7dfdf]/50 p-5"><dt class="font-serif text-lg text-charcoal">Waist</dt><dd class="mt-2 text-sm leading-relaxed text-charcoal/75">Measure around the narrowest part of your natural waistline, usually just above the belly button.</dd></div>
        <div class="rounded-2xl bg-[#f7dfdf]/50 p-5"><dt class="font-serif text-lg text-charcoal">Hip</dt><dd class="mt-2 text-sm leading-relaxed text-charcoal/75">Stand with feet together and measure around the fullest part of your hips.</dd></div>
      </dl>
      <p class="mt-5 text-sm text-charcoal-muted">Tip: measure over your underclothes and keep the tape snug but not tight for the most accurate fit.</p>
    </section>

    {%- comment -%} Fit Questions {%- endcomment -%}
    <section>
      <h2 class="mb-2 font-serif text-2xl">Fit Questions</h2>
      <div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'qa' -%}
            <details class="group border-b border-charcoal/15 py-4" {{ block.shopify_attributes }}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base text-charcoal marker:hidden">
                {{ block.settings.question }}
                <span class="shrink-0 text-xl leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span>
              </summary>
              <div class="mt-3 max-w-2xl text-sm leading-relaxed text-charcoal/75 [&_p]:mb-2">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>
  </div>

  {%- if section.settings.show_cta -%}
    <div class="mx-auto mt-16 max-w-3xl border-t border-charcoal/10 pt-10 text-center" data-reveal>
      <h2 class="font-serif text-2xl">{{ section.settings.cta_heading | default: 'Found your size?' }}</h2>
      {%- if section.settings.cta_body != blank -%}
        <p class="mx-auto mt-3 max-w-md text-sm text-charcoal-muted">{{ section.settings.cta_body }}</p>
      {%- endif -%}
      <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn-primary mt-6">{{ section.settings.cta_label | default: 'Shop The Capsule' }}</a>
    </div>
  {%- endif -%}
</div>

{%- assign qas = section.blocks | where: 'type', 'qa' -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":{{ shop.url | json }}},{"@type":"ListItem","position":2,"name":"Size Guide","item":{{ shop.url | append: page.url | json }}}]}
{%- if qas.size > 0 -%},
{"@type":"FAQPage","mainEntity":[{%- for b in qas -%}{"@type":"Question","name":{{ b.settings.question | strip_html | json }},"acceptedAnswer":{"@type":"Answer","text":{{ b.settings.answer | strip_html | json }}}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}
{%- endif -%}
]}
</script>

{% schema %}
{
  "name": "Size Guide",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Fit & Sizing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Size Guide" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Inclusive sizing from S to XXL, designed to drape beautifully on every body. Use the chart below to find your perfect fit." },
    { "type": "header", "content": "Call to action" },
    { "type": "checkbox", "id": "show_cta", "label": "Show CTA", "default": true },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Found your size?" },
    { "type": "textarea", "id": "cta_body", "label": "Body", "default": "Every piece comes with free shipping and easy 7-day size exchanges." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop The Capsule" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Fit question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How do I measure for the right size?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Use a soft measuring tape to measure your bust, waist, and hips, then match them to our size chart.</p>" }
      ]
    }
  ]
}
{% endschema %}
