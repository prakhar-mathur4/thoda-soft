{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_sizes = false
  unless product.has_only_default_variant
    assign has_sizes = true
  endunless
  assign images = product.media | where: 'media_type', 'image'
-%}

<div class="container-editorial pb-24 pt-8 sm:pt-10" data-product-root>
  <nav aria-label="Breadcrumb" class="mb-6 text-xs tracking-wide text-charcoal-muted">
    <a href="{{ routes.root_url }}" class="transition hover:text-charcoal">Home</a>
    <span class="mx-2">/</span>
    <span class="text-charcoal">{{ product.title }}</span>
  </nav>

  <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16">
    {%- comment -%}
      Gallery — swipeable snap-carousel on mobile, stacked column on desktop.
      Reuses the carousel dots wired up by global.js.
    {%- endcomment -%}
    <div data-carousel data-reveal>
      <div
        data-carousel-track
        class="flex snap-x snap-mandatory gap-3 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:grid md:grid-cols-1 md:gap-4 md:overflow-visible md:pb-0"
      >
        {%- if images.size > 0 -%}
          {%- for media in images -%}
            <div class="relative aspect-[4/5] w-full min-w-full shrink-0 snap-start overflow-hidden rounded-3xl bg-blush md:min-w-0">
              <img
                src="{{ media | image_url: width: 1100 }}"
                srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1400 }} 1400w"
                sizes="(min-width: 768px) 55vw, 100vw"
                alt="{{ media.alt | escape | default: product.title }}"
                width="1100" height="1375"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                class="absolute inset-0 h-full w-full object-cover">
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="aspect-[4/5] w-full min-w-full shrink-0 rounded-3xl bg-blush md:min-w-0"></div>
        {%- endif -%}
      </div>

      {%- if images.size > 1 -%}
        <div data-carousel-dots class="mt-4 flex justify-center gap-2 md:hidden"></div>
      {%- endif -%}
    </div>

    {%- comment -%} Info — sticky on desktop {%- endcomment -%}
    <div class="md:sticky md:top-24 md:self-start" data-reveal>
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow | default: 'The Debut Capsule' }}</p>
      <h1 class="font-serif text-3xl uppercase leading-tight tracking-[0.02em] sm:text-4xl">{{ product.title }}</h1>
      {%- comment -%} Links to the Judge.me review widget (its container id) {%- endcomment -%}
      {%- render 'rating-badge', product: product, href: '#judgeme_product_reviews', class: 'mt-3' -%}
      <p class="mt-4 text-xl font-medium text-charcoal" data-product-price>{{ current_variant.price | money }}</p>
      {%- if shop.taxes_included -%}
        <p class="mt-1 text-xs text-charcoal/70">Inclusive of all taxes</p>
      {%- endif -%}

      {%- liquid
        assign select_label = 'Select Size'
        if product.options_with_values.size > 1
          assign select_label = 'Select Sizes'
        endif
      -%}
      <form data-product-form novalidate {% if has_sizes %}data-select-label="{{ select_label }}"{% endif %}>
        <input type="hidden" name="id" data-variant-id value="{% unless has_sizes %}{{ current_variant.id }}{% endunless %}">

        {%- if has_sizes -%}
          {%- render 'variant-picker', product: product, show_size_chart: true -%}
        {%- endif -%}

        <button
          type="submit"
          data-add-to-cart
          {% if has_sizes %}disabled{% else %}{% unless current_variant.available %}disabled{% endunless %}{% endif %}
          class="mt-8 w-full bg-charcoal py-4 text-xs uppercase tracking-[0.2em] text-cream transition duration-300 ease-soft hover:bg-charcoal/90 disabled:cursor-not-allowed disabled:opacity-50">
          <span data-add-label>{% if has_sizes %}{{ select_label }}{% else %}{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}{% endif %}</span>
        </button>

        {%- comment -%}
          Low-stock nudge. Filled by resolveVariant() in global.js from the real
          tracked quantity of the chosen variant (variant-picker emits `qty` only
          for variants Shopify tracks and won't oversell). Threshold 0 turns it off.
        {%- endcomment -%}
        {%- if section.settings.low_stock_threshold > 0 -%}
          <p data-stock-note data-threshold="{{ section.settings.low_stock_threshold }}" class="mt-3 hidden text-center text-xs font-medium text-charcoal" role="status"></p>
        {%- endif -%}
      </form>

      {%- comment -%} Reassurance — answers shipping / COD / exchange doubts right at the button {%- endcomment -%}
      {%- liquid
        assign usp_icons = 'truck,cash,exchange,clock' | split: ','
        capture usp_raw
          echo section.settings.usp_1 | append: '|||' | append: section.settings.usp_2 | append: '|||' | append: section.settings.usp_3 | append: '|||' | append: section.settings.usp_4
        endcapture
        assign usps = usp_raw | split: '|||'
      -%}
      <ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-3 rounded-2xl bg-blush/50 px-4 py-4 text-xs text-charcoal empty:hidden">
        {%- for usp in usps -%}
          {%- assign usp_text = usp | strip -%}
          {%- if usp_text != blank -%}
            <li class="flex items-center gap-2">{%- render 'icon', name: usp_icons[forloop.index0], class: 'h-4 w-4 shrink-0' -%}<span>{{ usp_text }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- render 'share-button', product: product -%}

      {%- comment -%}
        Payment offers / EMI — sits between the share button and the accordions.
        Two routes, both land here: the `razorpay_offers` block (theme-owned
        embed, needs a Key ID) and `@app` blocks, so Razorpay's own Shopify app
        block can be dropped in from the Theme Editor instead.
      {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'razorpay_offers' -%}
            {%- render 'razorpay-affordability', product: product, block: block -%}
          {%- when '@app' -%}
            <div class="mt-8" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endcase -%}
      {%- endfor -%}

      {%- comment -%} Accordions {%- endcomment -%}
      <div class="mt-10">
        {%- if product.description != blank -%}
          <details open class="group border-b border-charcoal/15 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">Details<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-3 text-sm leading-relaxed text-charcoal/75 [&_p]:mb-3">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- comment -%}
          Highlights: per-product via the `custom.highlights` metafield (a list
          of `product_highlight` metaobjects). Falls back to the shared section
          `highlight` blocks when a product has no metafield set.
        {%- endcomment -%}
        {%- assign mf_highlights = product.metafields.custom.highlights.value -%}
        {%- assign block_highlights = section.blocks | where: 'type', 'highlight' -%}
        {%- if mf_highlights != blank and mf_highlights.size > 0 -%}
          <details class="group border-b border-charcoal/15 py-4" {% if section.settings.highlights_open %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ section.settings.highlights_heading | default: 'What Makes It Great' }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-5 space-y-5">
              {%- for entry in mf_highlights -%}
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-charcoal/5 text-charcoal">
                    {%- if entry.icon_image.value != blank -%}
                      <img src="{{ entry.icon_image.value | image_url: width: 48 }}" alt="" width="22" height="22" class="h-5 w-5 object-contain">
                    {%- elsif entry.icon.value != blank -%}
                      {%- render 'icon', name: entry.icon.value, class: 'h-5 w-5' -%}
                    {%- else -%}
                      {%- render 'icon', name: 'sparkle', class: 'h-5 w-5' -%}
                    {%- endif -%}
                  </span>
                  <div>
                    <p class="font-medium text-charcoal">{{ entry.title.value }}</p>
                    {%- if entry.description.value != blank -%}<p class="mt-0.5 text-sm leading-relaxed text-charcoal/70">{{ entry.description.value }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </details>
        {%- elsif block_highlights.size > 0 -%}
          <details class="group border-b border-charcoal/15 py-4" {% if section.settings.highlights_open %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ section.settings.highlights_heading | default: 'What Makes It Great' }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-5 space-y-5">
              {%- for block in block_highlights -%}
                <div class="flex items-start gap-4" {{ block.shopify_attributes }}>
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-charcoal/5 text-charcoal">
                    {%- if block.settings.icon_image -%}
                      <img src="{{ block.settings.icon_image | image_url: width: 48 }}" alt="" width="22" height="22" class="h-5 w-5 object-contain">
                    {%- else -%}
                      {%- render 'icon', name: block.settings.icon, class: 'h-5 w-5' -%}
                    {%- endif -%}
                  </span>
                  <div>
                    <p class="font-medium text-charcoal">{{ block.settings.title }}</p>
                    {%- if block.settings.text != blank -%}<p class="mt-0.5 text-sm leading-relaxed text-charcoal/70">{{ block.settings.text }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            {%- comment -%}
              Content is per-product when the block names a product metafield
              (e.g. "custom.materials_care") and that product has it set; else
              it falls back to the block's shared content.
            {%- endcomment -%}
            {%- assign acc_content = block.settings.content -%}
            {%- if block.settings.metafield != blank -%}
              {%- assign mf_parts = block.settings.metafield | split: '.' -%}
              {%- assign pmf = product.metafields[mf_parts[0]][mf_parts[1]] -%}
              {%- if pmf != blank -%}
                {%- comment -%} rich_text_field is stored as JSON; metafield_tag renders it as HTML {%- endcomment -%}
                {%- if pmf.type == 'rich_text_field' -%}
                  {%- assign acc_content = pmf | metafield_tag -%}
                {%- else -%}
                  {%- assign acc_content = pmf.value | newline_to_br -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
            {%- if acc_content != blank -%}
              <details class="group border-b border-charcoal/15 py-4" {{ block.shopify_attributes }}>
                <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ block.settings.title }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
                <div class="mt-3 text-sm leading-relaxed text-charcoal/75 [&_p]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_a]:underline [&_a]:underline-offset-2">{{ acc_content }}</div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  Mobile sticky buy bar. global.js slides it in whenever the main Add to Cart
  button is off-screen and mirrors that button's label / state. Tapping it
  submits the main form, or scrolls to the size picker if no size is chosen yet.
  `body.has-sticky-atc` (src/theme.css) lifts the chat bubble clear of it.
{%- endcomment -%}
<div data-sticky-atc aria-hidden="true" class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-charcoal/10 bg-cream/95 px-4 pb-[calc(0.75rem+env(safe-area-inset-bottom))] pt-3 shadow-[0_-8px_24px_rgba(46,43,41,0.08)] backdrop-blur transition-transform duration-300 ease-soft md:hidden">
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate font-serif text-sm text-charcoal">{{ product.title }}</p>
      <p class="text-sm font-medium text-charcoal" data-sticky-price>{{ current_variant.price | money }}</p>
    </div>
    <button type="button" data-cart-open aria-label="{{ 'general.accessibility.cart' | t }}" class="relative shrink-0 rounded-full border border-charcoal/20 p-2.5 text-charcoal transition active:scale-95">
      {%- render 'icon', name: 'bag' -%}
      <span data-cart-count class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-charcoal px-1 text-[10px] font-medium text-cream{% if cart.item_count == 0 %} hidden{% endif %}">{{ cart.item_count }}</span>
    </button>
    <button type="button" data-sticky-atc-btn tabindex="-1" class="shrink-0 rounded-full bg-charcoal px-6 py-3 text-xs uppercase tracking-[0.15em] text-cream transition active:scale-95 disabled:opacity-50">
      <span data-sticky-label>{% if has_sizes %}{{ select_label }}{% else %}{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}{% endif %}</span>
    </button>
  </div>
</div>

{%- render 'size-guide-modal', product: product -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ current_variant.price | divided_by: 100.0 }}",
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ shop.url | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Debut Capsule" },
    { "type": "header", "content": "Reassurance under Add to Cart" },
    { "type": "text", "id": "usp_1", "label": "Line 1 (truck icon)", "default": "Free shipping across India" },
    { "type": "text", "id": "usp_2", "label": "Line 2 (cash icon)", "default": "Cash on Delivery available" },
    { "type": "text", "id": "usp_3", "label": "Line 3 (exchange icon)", "default": "7-day size exchange" },
    { "type": "text", "id": "usp_4", "label": "Line 4 (clock icon)", "default": "Dispatched in 1–2 business days" },
    { "type": "range", "id": "low_stock_threshold", "min": 0, "max": 10, "step": 1, "label": "Show “Only X left” at or below", "default": 3, "info": "Uses the real tracked stock of the selected size. 0 = never show." },
    { "type": "header", "content": "What Makes It Great" },
    { "type": "text", "id": "highlights_heading", "label": "Heading", "default": "What Makes It Great" },
    { "type": "checkbox", "id": "highlights_open", "label": "Open by default", "default": true },
    { "type": "paragraph", "content": "Per-product: set the product’s “Highlights” metafield (custom.highlights → list of Product highlight metaobjects). The “Highlight” blocks below are the shared fallback shown when a product has no metafield set." }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "pin", "label": "Pin" },
            { "value": "clock", "label": "Clock" },
            { "value": "lock", "label": "Lock" },
            { "value": "eye", "label": "Eye" },
            { "value": "bag", "label": "Bag" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)", "info": "Overrides the icon above. Use a simple line-art PNG/SVG." },
        { "type": "text", "id": "title", "label": "Title", "default": "The Design" },
        { "type": "text", "id": "text", "label": "Description", "default": "Thoughtful, flattering tailoring that moves with you." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Size & Fit" },
        { "type": "richtext", "id": "content", "label": "Content (shared fallback)", "default": "<p>True to size with a relaxed, feminine drape. Inclusive sizing from XS–3XL.</p>" },
        { "type": "text", "id": "metafield", "label": "Per-product metafield", "info": "Optional. e.g. custom.materials_care — when a product has this metafield, its value is shown instead of the fallback above." }
      ]
    },
    {
      "type": "razorpay_offers",
      "name": "Razorpay offers & EMI",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows Razorpay’s Affordability Widget — EMI, Cardless EMI, Pay Later and your live offers. Appears below “Share the vibe”, above the accordions. The offers themselves are managed in your Razorpay Dashboard → Affordability, not here, and Razorpay renders its own styling." },
        { "type": "text", "id": "key_id", "label": "Razorpay Key ID", "info": "Razorpay Dashboard → Account & Settings → API keys. Use an rzp_test_… key to preview, then swap in your rzp_live_… key and turn the widget on under Affordability → Go live. Leave empty to hide the widget." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Offers & EMI", "info": "Leave empty for no heading." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "highlight", "settings": { "icon": "sparkle", "title": "The Design", "text": "Thoughtful, flattering tailoring that moves with you." } },
        { "type": "highlight", "settings": { "icon": "leaf", "title": "The Fabric", "text": "Breathable, carefully chosen fabric that feels soft on the skin." } },
        { "type": "accordion", "settings": { "title": "Size & Fit", "content": "<p>True to size with a relaxed, feminine drape. Inclusive sizing from XS–3XL. Between sizes? Size down for a closer fit, up for extra ease.</p>" } },
        { "type": "accordion", "settings": { "title": "Materials & Care", "content": "<p>Breathable fabrics. Machine wash cold on a gentle cycle, line dry, warm iron if needed.</p>" } },
        { "type": "accordion", "settings": { "title": "Shipping & Returns", "content": "<p>Free shipping on all orders. 7-day size exchanges. Secure checkout, every time.</p>" } }
      ]
    }
  ]
}
{% endschema %}
