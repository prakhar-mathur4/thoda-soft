{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_option = product.options_with_values[0]
  assign has_sizes = false
  unless product.has_only_default_variant
    assign has_sizes = true
  endunless
  assign images = product.media | where: 'media_type', 'image'
-%}

<div class="container-editorial pb-24 pt-8 sm:pt-10" data-product-root>
  <nav aria-label="Breadcrumb" class="mb-6 text-xs tracking-wide text-charcoal-muted">
    <a href="{{ routes.root_url }}" class="transition hover:text-charcoal">Home</a>
    <span class="mx-2">/</span>
    <span class="text-charcoal">{{ product.title }}</span>
  </nav>

  <div class="grid grid-cols-1 items-start gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16">
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="grid grid-cols-1 gap-3 sm:gap-4" data-reveal data-reveal-stagger>
      {%- if images.size > 0 -%}
        {%- for media in images -%}
          <div class="relative aspect-[4/5] w-full overflow-hidden rounded-3xl bg-blush">
            <img
              src="{{ media | image_url: width: 1100 }}"
              srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 768px) 55vw, 100vw"
              alt="{{ media.alt | escape | default: product.title }}"
              width="1100" height="1375"
              {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
              class="absolute inset-0 h-full w-full object-cover">
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="aspect-[4/5] w-full rounded-3xl bg-blush"></div>
      {%- endif -%}
    </div>

    {%- comment -%} Info — sticky on desktop {%- endcomment -%}
    <div class="md:sticky md:top-24 md:self-start" data-reveal>
      <p class="mb-3 text-xs uppercase tracking-[0.25em] text-charcoal-muted">{{ section.settings.eyebrow | default: 'The Debut Capsule' }}</p>
      <h1 class="font-serif text-3xl uppercase leading-tight tracking-[0.02em] sm:text-4xl">{{ product.title }}</h1>
      <p class="mt-4 text-lg text-charcoal" data-product-price>{{ current_variant.price | money }}</p>
      <p class="mt-2 text-xs uppercase tracking-[0.12em] text-sage-deep">Free shipping on all orders</p>

      <form data-product-form novalidate>
        <input type="hidden" name="id" data-variant-id value="{{ current_variant.id }}">

        {%- if has_sizes -%}
          <fieldset class="mt-8">
            <legend class="mb-3 flex w-full items-center justify-between text-xs uppercase tracking-[0.12em] text-charcoal">
              <span class="flex items-center gap-2">{{ size_option.name }}<span data-soldout-note class="normal-case tracking-normal text-charcoal-muted{% if current_variant.available %} hidden{% endif %}"> · Sold out</span></span>
              <button type="button" data-size-guide-open class="normal-case tracking-normal text-charcoal-muted underline underline-offset-2 transition hover:text-charcoal">{{ 'products.product.size_chart' | t }}</button>
            </legend>
            <div class="flex flex-wrap gap-2" data-variant-picker>
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  data-variant-option
                  data-variant-id="{{ variant.id }}"
                  data-available="{{ variant.available }}"
                  data-price="{{ variant.price | money }}"
                  aria-pressed="{% if variant.id == current_variant.id %}true{% else %}false{% endif %}"
                  class="min-w-12 rounded-full border px-4 py-2.5 text-sm uppercase tracking-wide transition ease-soft border-charcoal/25 text-charcoal hover:border-charcoal aria-pressed:border-charcoal aria-pressed:bg-charcoal aria-pressed:text-cream {% unless variant.available %}cursor-not-allowed text-charcoal/30 line-through hover:border-charcoal/25{% endunless %}">
                  {{ variant.option1 }}
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        <button
          type="submit"
          data-add-to-cart
          {% unless current_variant.available %}disabled{% endunless %}
          class="mt-8 w-full bg-charcoal py-4 text-xs uppercase tracking-[0.2em] text-cream transition duration-300 ease-soft hover:bg-charcoal/90 disabled:cursor-not-allowed disabled:opacity-50">
          <span data-add-label>{% if current_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
        </button>
      </form>

      {%- comment -%} Accordions {%- endcomment -%}
      <div class="mt-10">
        {%- if product.description != blank -%}
          <details open class="group border-b border-charcoal/15 py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">Details<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-3 text-sm leading-relaxed text-charcoal/75 [&_p]:mb-3">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- comment -%}
          Highlights: per-product via the `custom.highlights` metafield (a list
          of `product_highlight` metaobjects). Falls back to the shared section
          `highlight` blocks when a product has no metafield set.
        {%- endcomment -%}
        {%- assign mf_highlights = product.metafields.custom.highlights.value -%}
        {%- assign block_highlights = section.blocks | where: 'type', 'highlight' -%}
        {%- if mf_highlights != blank and mf_highlights.size > 0 -%}
          <details class="group border-b border-charcoal/15 py-4" {% if section.settings.highlights_open %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ section.settings.highlights_heading | default: 'What Makes It Great' }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-5 space-y-5">
              {%- for entry in mf_highlights -%}
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-charcoal/5 text-charcoal">
                    {%- if entry.icon_image.value != blank -%}
                      <img src="{{ entry.icon_image.value | image_url: width: 48 }}" alt="" width="22" height="22" class="h-5 w-5 object-contain">
                    {%- elsif entry.icon.value != blank -%}
                      {%- render 'icon', name: entry.icon.value, class: 'h-5 w-5' -%}
                    {%- else -%}
                      {%- render 'icon', name: 'sparkle', class: 'h-5 w-5' -%}
                    {%- endif -%}
                  </span>
                  <div>
                    <p class="font-medium text-charcoal">{{ entry.title.value }}</p>
                    {%- if entry.description.value != blank -%}<p class="mt-0.5 text-sm leading-relaxed text-charcoal/70">{{ entry.description.value }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </details>
        {%- elsif block_highlights.size > 0 -%}
          <details class="group border-b border-charcoal/15 py-4" {% if section.settings.highlights_open %}open{% endif %}>
            <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ section.settings.highlights_heading | default: 'What Makes It Great' }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
            <div class="mt-5 space-y-5">
              {%- for block in block_highlights -%}
                <div class="flex items-start gap-4" {{ block.shopify_attributes }}>
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-charcoal/5 text-charcoal">
                    {%- if block.settings.icon_image -%}
                      <img src="{{ block.settings.icon_image | image_url: width: 48 }}" alt="" width="22" height="22" class="h-5 w-5 object-contain">
                    {%- else -%}
                      {%- render 'icon', name: block.settings.icon, class: 'h-5 w-5' -%}
                    {%- endif -%}
                  </span>
                  <div>
                    <p class="font-medium text-charcoal">{{ block.settings.title }}</p>
                    {%- if block.settings.text != blank -%}<p class="mt-0.5 text-sm leading-relaxed text-charcoal/70">{{ block.settings.text }}</p>{%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </details>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details class="group border-b border-charcoal/15 py-4" {{ block.shopify_attributes }}>
              <summary class="flex cursor-pointer list-none items-center justify-between text-sm uppercase tracking-[0.12em] text-charcoal marker:hidden">{{ block.settings.title }}<span class="ml-4 text-lg leading-none text-charcoal-muted transition-transform duration-300 ease-soft group-open:rotate-45">+</span></summary>
              <div class="mt-3 text-sm leading-relaxed text-charcoal/75 [&_p]:mb-3">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- render 'size-guide-modal' -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "url": {{ shop.url | append: product.url | json }},
  {% if product.featured_media %}"image": {{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ current_variant.price | divided_by: 100.0 }}",
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ shop.url | append: product.url | json }}
  }
}
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Debut Capsule" },
    { "type": "header", "content": "What Makes It Great" },
    { "type": "text", "id": "highlights_heading", "label": "Heading", "default": "What Makes It Great" },
    { "type": "checkbox", "id": "highlights_open", "label": "Open by default", "default": true },
    { "type": "paragraph", "content": "Per-product: set the product’s “Highlights” metafield (custom.highlights → list of Product highlight metaobjects). The “Highlight” blocks below are the shared fallback shown when a product has no metafield set." }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "pin", "label": "Pin" },
            { "value": "clock", "label": "Clock" },
            { "value": "lock", "label": "Lock" },
            { "value": "eye", "label": "Eye" },
            { "value": "bag", "label": "Bag" }
          ],
          "default": "sparkle"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon (optional)", "info": "Overrides the icon above. Use a simple line-art PNG/SVG." },
        { "type": "text", "id": "title", "label": "Title", "default": "The Design" },
        { "type": "text", "id": "text", "label": "Description", "default": "Thoughtful, flattering tailoring that moves with you." }
      ]
    },
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Size & Fit" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>True to size with a relaxed, feminine drape. Inclusive sizing from S–XXL.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product",
      "blocks": [
        { "type": "highlight", "settings": { "icon": "sparkle", "title": "The Design", "text": "Thoughtful, flattering tailoring that moves with you." } },
        { "type": "highlight", "settings": { "icon": "leaf", "title": "The Fabric", "text": "Premium, breathable cotton that softens with every wash." } },
        { "type": "accordion", "settings": { "title": "Size & Fit", "content": "<p>True to size with a relaxed, feminine drape. Inclusive sizing from S–XXL. Between sizes? Size down for a closer fit, up for extra ease.</p>" } },
        { "type": "accordion", "settings": { "title": "Materials & Care", "content": "<p>Premium ultra-soft cotton. Machine wash cold on a gentle cycle, line dry, warm iron if needed.</p>" } },
        { "type": "accordion", "settings": { "title": "Shipping & Returns", "content": "<p>Free shipping on all orders. 7-day size exchanges. Secure checkout, every time.</p>" } }
      ]
    }
  ]
}
{% endschema %}
