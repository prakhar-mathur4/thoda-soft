<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_cream }}">
    <title>{{ 'gift_cards.issued.title' | t: value: gift_card.balance | money }} &ndash; {{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap"
      rel="stylesheet">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="bg-cream text-charcoal font-sans antialiased">
    <main class="container-editorial flex min-h-screen flex-col items-center justify-center py-16 text-center">
      {%- if settings.logo -%}
        <img
          src="{{ settings.logo | image_url: width: 400 }}"
          alt="{{ shop.name | escape }}"
          class="mx-auto mb-6 h-12 w-auto object-contain"
          width="200"
          height="53">
      {%- else -%}
        <h1 class="mb-6 font-serif text-3xl">{{ shop.name }}</h1>
      {%- endif -%}

      <div class="w-full max-w-md rounded-4xl bg-blush p-8 sm:p-10">
        <p class="text-xs uppercase tracking-[0.2em] text-charcoal-muted">Gift card</p>
        <p class="mt-4 font-serif text-5xl">{{ gift_card.balance | money }}</p>

        {%- if gift_card.balance != gift_card.initial_value -%}
          <p class="mt-2 text-sm text-charcoal-muted">Initial value {{ gift_card.initial_value | money }}</p>
        {%- endif -%}

        <p class="mt-8 text-xs uppercase tracking-[0.2em] text-charcoal-muted">Your code</p>
        <p class="mt-2 select-all rounded-full border border-charcoal/20 bg-white px-5 py-3 font-mono text-lg tracking-[0.2em]">
          {{ gift_card.code | format_code }}
        </p>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}" class="mt-4 inline-block text-xs uppercase tracking-[0.14em] text-charcoal underline underline-offset-2">Add to Apple Wallet</a>
        {%- endif -%}

        {%- if gift_card.expired -%}
          <p class="mt-4 text-sm text-charcoal">This gift card has expired.</p>
        {%- elsif gift_card.expires_on -%}
          <p class="mt-4 text-sm text-charcoal-muted">Valid until {{ gift_card.expires_on | date: '%b %d, %Y' }}</p>
        {%- endif -%}
      </div>

      <div class="mt-8 flex flex-col items-center gap-3">
        <a href="{{ shop.url }}" class="btn-primary">Start shopping</a>
        <button type="button" onclick="window.print()" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted underline underline-offset-2 hover:text-charcoal">
          Print gift card
        </button>
      </div>

      <p class="mt-10 text-xs uppercase tracking-[0.2em] text-charcoal-muted">{{ powered_by_link }}</p>
    </main>
  </body>
</html>
