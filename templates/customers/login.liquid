<div class="container-editorial py-16 max-w-lg" data-customer-login>
  {%- comment -%} Login {%- endcomment -%}
  <div id="login" class="[&.hidden]:hidden">
    <h1 class="font-serif text-3xl">{{ 'customer.log_in' | t | default: 'Log in' }}</h1>

    {%- form 'customer_login', class: 'mt-8 space-y-5' -%}
      {{ form.errors | default_errors }}

      <div>
        <label for="CustomerEmail" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Email</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" autocapitalize="off" autocorrect="off" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
      </div>

      <div>
        <label for="CustomerPassword" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Password</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
      </div>

      <button type="submit" class="btn-primary w-full">{{ 'customer.log_in' | t | default: 'Log in' }}</button>

      <div class="flex items-center justify-between text-xs uppercase tracking-[0.12em] text-charcoal-muted">
        <a href="#recover" data-recover-toggle class="underline underline-offset-2 hover:text-charcoal">Forgot password?</a>
        <a href="{{ routes.account_register_url }}" class="underline underline-offset-2 hover:text-charcoal">Create account</a>
      </div>
    {%- endform -%}
  </div>

  {%- comment -%} Recover password {%- endcomment -%}
  <div id="recover" class="hidden [&:not(.hidden)]:block">
    <h1 class="font-serif text-3xl">Reset your password</h1>
    <p class="mt-3 text-sm text-charcoal-muted">We'll send you an email to reset your password.</p>

    {%- form 'recover_customer_password', class: 'mt-8 space-y-5' -%}
      {{ form.errors | default_errors }}
      {%- if form.posted_successfully? -%}
        <p class="rounded-3xl bg-sage p-4 text-sm text-charcoal">We've sent you an email with a link to update your password.</p>
      {%- endif -%}

      <div>
        <label for="RecoverEmail" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Email</label>
        <input type="email" id="RecoverEmail" name="email" autocomplete="email" autocapitalize="off" autocorrect="off" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
      </div>

      <button type="submit" class="btn-primary w-full">Send reset link</button>
      <a href="#login" data-recover-toggle class="block text-center text-xs uppercase tracking-[0.12em] text-charcoal-muted underline underline-offset-2 hover:text-charcoal">Back to log in</a>
    {%- endform -%}
  </div>
</div>
