<div class="container-editorial py-16 max-w-lg">
  <h1 class="font-serif text-3xl">Activate account</h1>
  <p class="mt-3 text-sm text-charcoal-muted">Create a password to activate your account.</p>

  {%- form 'activate_customer_password', class: 'mt-8 space-y-5' -%}
    {{ form.errors | default_errors }}

    <div>
      <label for="ActivatePassword" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Password</label>
      <input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <div>
      <label for="ActivatePasswordConfirm" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Confirm password</label>
      <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <div class="flex flex-col gap-3">
      <button type="submit" name="commit" class="btn-primary w-full">Activate account</button>
      <button type="submit" name="decline" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted underline underline-offset-2 hover:text-charcoal">Decline invitation</button>
    </div>
  {%- endform -%}
</div>
