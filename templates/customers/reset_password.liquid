<div class="container-editorial py-16 max-w-lg">
  <h1 class="font-serif text-3xl">Reset your password</h1>
  <p class="mt-3 text-sm text-charcoal-muted">Enter a new password for your account.</p>

  {%- form 'reset_customer_password', class: 'mt-8 space-y-5' -%}
    {{ form.errors | default_errors }}

    <div>
      <label for="ResetPassword" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">New password</label>
      <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <div>
      <label for="ResetPasswordConfirm" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Confirm password</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <button type="submit" class="btn-primary w-full">Reset password</button>
  {%- endform -%}
</div>
