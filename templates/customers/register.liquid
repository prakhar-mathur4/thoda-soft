<div class="container-editorial py-16 max-w-lg">
  <h1 class="font-serif text-3xl">Create account</h1>

  {%- form 'create_customer', class: 'mt-8 space-y-5' -%}
    {{ form.errors | default_errors }}

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label for="FirstName" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">First name</label>
        <input type="text" id="FirstName" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name" class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
      </div>
      <div>
        <label for="LastName" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Last name</label>
        <input type="text" id="LastName" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name" class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
      </div>
    </div>

    <div>
      <label for="RegisterEmail" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Email</label>
      <input type="email" id="RegisterEmail" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" autocorrect="off" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <div>
      <label for="RegisterPassword" class="text-xs uppercase tracking-[0.12em] text-charcoal-muted">Password</label>
      <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required class="mt-1 rounded-full border border-charcoal/20 bg-white px-5 py-3 text-sm outline-none focus:border-charcoal/40 w-full">
    </div>

    <button type="submit" class="btn-primary w-full">Create account</button>

    <a href="{{ routes.account_login_url }}" class="block text-center text-xs uppercase tracking-[0.12em] text-charcoal-muted underline underline-offset-2 hover:text-charcoal">
      Already have an account? {{ 'customer.log_in' | t | default: 'Log in' }}
    </a>
  {%- endform -%}
</div>
